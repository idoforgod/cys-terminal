#!/usr/bin/env bash
# cys-dept — 부서(독립 데몬) 운용 정식 도구 (멀티마스터 정식화 F2)
#
#   cys-dept launch <name>    부서 데몬 spawn + ACL 시드 + 부서장 자리 + (부서≥1)CEO 승격 + 레지스트리 등재
#   cys-dept down   <name>    teardown: SIGTERM + 소켓/lock 정리 + 레지스트리 해제 + (마지막)CEO 강등
#   cys-dept rotate <name>    버전 스큐 세대교체(재기동): 데몬 프로세스만 정지→새 on-disk cysd로 재기동
#                             (★폐기 아님 — 레지스트리·묘비·CEO 불변). stdout 마지막 줄=rotated <name>: vX→vY
#   cys-dept list             부서명 목록
#   cys-dept sock   <name>    부서 소켓 경로 출력 (broadcast fan-out 루프용)
#   cys-dept <name> -- <cmd>  부서 컨텍스트(CYS_SOCKET+CYS_PACK_DIR)로 명령 실행
#
# 격리 불변식: 부서마다 socket의 *부모 디렉토리*와 pack_dir이 서로 달라야 한다(state_dir·ACL 격리).
# 단일 진입점: Tauri/UI·CLI 모두 이 도구를 거쳐 부서를 운용한다(직접 cysd spawn 금지 — 레지스트리/ACL 미시드 방지).
set -euo pipefail

# ★PATH 보강(GUI Finder/Dock 런칭 대응): cys.app은 launchd 기본 PATH(/usr/bin:/bin:/usr/sbin:/sbin)만
# 상속해 cys(/opt/homebrew/bin)·claude(~/.local/bin)를 못 찾는다 → 빈 셸의 `cys status`·사용자의 claude
# 수동 실행 실패·dept cysd 의 claude spawn 실패 = 0 pane. 이 도구가 spawn 하는 모든 자식(cysd·빈 셸·
# 그 아래 사용자가 실행하는 claude)이 상속하도록 단일 지점에서 로그인 셸 표준 경로를 prepend.
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin${PATH:+:$PATH}"

REG="${CYS_DEPTS_JSON:-$HOME/.cys/depts.json}"
PACK_DEFAULT="$HOME/.cys/pack"
# RC-6: 폴백 경로 가드 — command -v 우선(Windows는 RC-5 runtime PATH로 cysd.exe/cys.exe 해소).
# /opt/homebrew는 macOS 전용이라 존재할 때만 폴백(Windows서 유령 경로 방지), 최종 폴백=bare 이름.
CYSD="$(command -v cysd || { [ -x /opt/homebrew/bin/cysd ] && echo /opt/homebrew/bin/cysd; } || echo cysd)"
CYS="$(command -v cys || { [ -x /opt/homebrew/bin/cys ] && echo /opt/homebrew/bin/cys; } || echo cys)"
# RC-6(codex R3.1 nit): 인라인 python heredoc이 cys를 literal이 아니라 **해소된 경로**로 실행하도록
# CYS_BIN을 env로 전파(heredoc은 프로세스 env 상속). dept_classify_idle·alive_sock 등 subprocess가 사용.
export CYS_BIN="$CYS"
# RC-6(T3 발견): Windows 번들 embeddable Python은 open() 기본 인코딩이 cp1252(charmap)라 UTF-8(한글)
# agents.json·directives 읽기가 UnicodeDecodeError로 크래시(부서 seed 실패 등). PYTHONUTF8=1로 전 python
# heredoc·자식 python을 UTF-8 기본으로 강제(unix 무영향). 개별 open(encoding=) 누락도 이걸로 방어.
export PYTHONUTF8=1
# ★SEAL-1(2026-08-01 실사고): 이 도구가 spawn 하는 자식들은 cys.app 번들 안의 python 을 물 수 있다
# (PATH 선두 = Contents/Resources/runtime/python/bin). 그 python 이 stdlib import 중 번들 안에
# `__pycache__/*.pyc` 를 쓰면 코드서명 봉인이 깨지고("file added: …cpython-312.pyc"), quarantine 이
# 붙은 사본은 Gatekeeper 재검증에서 "손상되었기 때문에 열 수 없습니다"로 차단된다. PYTHONUTF8 과
# 같은 자리에서 같은 방식(단일 지점 export → 전 자식 상속)으로 봉인한다.
# 값은 반드시 비어 있지 않아야 한다(CPython 은 빈 문자열을 '끔'으로 읽는다) — Rust 정본은
# src/lib.rs ENV_PY_NO_BYTECODE, 대안(PYTHONPYCACHEPREFIX) 비교 근거도 그 주석에 있다.
export PYTHONDONTWRITEBYTECODE=1

# RC-4: 부서 소켓 규약 — Windows(MSYS/Git-Bash)는 named pipe `\\.\pipe\cys-dept-<n>`
# (cysd가 CYS_SOCKET을 named pipe로 바인드·Rust cys::dept_socket_path와 정합), 그 외는 unix .sock.
dept_sock(){
  case "$(uname -s 2>/dev/null)" in
    MINGW*|MSYS*|CYGWIN*) echo "\\\\.\\pipe\\cys-dept-$1" ;;
    *) echo "$HOME/.local/state/cys-dept-$1/cys.sock" ;;
  esac
}
dept_pack(){ echo "$HOME/.cys/pack-dept-$1"; }
# ★기능2: 부서 state 디렉토리(대화기억 transcripts.db 보관·실측 최대 324MB) = 소켓의 부모.
# discover_depts(javis_phoenix.py:1082 glob `state_root/cys-dept-*`)와 동일 규약 — 이 경로가 사라지면
# 재발견이 끊겨 부활이 영구 차단된다(rm 아닌 격리가 유일 복구 경로 · javis_backup default_roots 무포함).
# Windows named pipe엔 형제 디렉토리 개념이 없어 unix 한정(named pipe면 dirname 무의미 → purge_state skip).
dept_state(){ dirname "$(dept_sock "$1")"; }
# ★기능2: 격리(휴지통) 루트 — 삭제는 전부 mv로 통일(백업 없는 rm 금지). discover_depts glob은
# `cys-dept-*`만 매치하므로 `cys-trash/`는 무매치 = 재발견 절단(격리=부활 차단·복구 가능 양립).
TRASH_ROOT="$HOME/.local/state/cys-trash"

# ★W2a-4 의도삭제 → phoenix dept 묘비: 부서 전체 폐기(down/down-sock=의도적 teardown)를 phoenix
# 보호집합(base dept_roster)에 명시적 폐역으로 기록해, 부활 보고가 폐기된 부서를 '부활 필요'로
# 오보하지 않게 한다. best-effort — phoenix 부재·실패가 teardown을 절대 깨지 않는다(|| true·무출력).
dept_tombstone(){
  [ -n "${1:-}" ] || return 0
  # ★D-IMPL-2 대칭 계약: phoenix 묘비와 데몬 묘비(base cysd topology)는 항상 쌍으로 set/remove —
  # 데몬 묘비는 리바이버(spawn_org_restore·프론트 복원)의 게이트, phoenix 묘비는 보호집합의 게이트.
  # GUI 삭제의 의도-선기록(Tauri dept_tombstone_by_socket)과는 멱등 중복(무해). best-effort.
  # ★D3(i) 인자 위생: clap `--` 옵션 종단 — '-' 선두 등재명(레거시 잔재)이 옵션으로 오파싱돼
  #   묘비가 무음 미기록되는 부활 구멍 봉합(cys 호출 공통 규약: --dept [--remove] -- "$name").
  env -u CYS_SOCKET "$CYS" tombstone --dept -- "$1" >/dev/null 2>&1 || true
  ph="${CYS_PACK_DIR:-$PACK_DEFAULT}/bin/javis_phoenix.py"
  [ -f "$ph" ] || return 0
  python3 "$ph" tombstone "$1" --dept >/dev/null 2>&1 || true
}
# ★재생성 묘비 해소(BOOTSTRAP_HARDENING WP-3·R6ⓒ): 삭제된 동명 부서를 다시 만들면 묘비를 해제해야
# 새 부서가 피닉스 보호집합에 재편입된다(미해소=삭제→재생성 부서가 보호 영구 제외되는 역전 결함).
# 성공 경로 말미에서만 호출(예약 직후 해소는 생성 실패 시 유령 보호 재편입 위험). rotate는 호출 금지
# (rotate=묘비 불변 계약 — CYS_DEPT_ROTATE 가드). best-effort(|| true — 생성 흐름 불파괴).
dept_tombstone_remove(){
  [ -n "${1:-}" ] || return 0
  [ "${CYS_DEPT_ROTATE:-}" = "1" ] && return 0
  # ★D-IMPL-2: 데몬 묘비도 함께 해소 — 이게 없으면 삭제→동명/동번호 재생성 부서를
  # spawn_org_restore가 묘비로 오판해 reap(재생성-살해). phoenix와 쌍 유지.
  # ★R11(적대검증 A2): 해소 실패는 무음 금지 — 잔존 묘비=재생성 부서 reap이므로 WARN 가시화
  # (비치명: 다음 재생성/lifecycle 재시도가 재해소).
  # ★D3(i) 인자 위생: `--` 종단(위 dept_tombstone과 동일 규약).
  env -u CYS_SOCKET "$CYS" tombstone --dept --remove -- "$1" >/dev/null 2>&1 \
    || echo "[cys-dept] WARN: 데몬 묘비 해소 미확정($1 — base 미도달) — 재시도 필요(잔존 시 재시작에서 부서 reap 위험)" >&2
  ph="${CYS_PACK_DIR:-$PACK_DEFAULT}/bin/javis_phoenix.py"
  [ -f "$ph" ] || return 0
  python3 "$ph" tombstone "$1" --dept --remove >/dev/null 2>&1 || true
}

# ★T9(P3-1 ⓐ): 상비편성 배선 — 생성 동사(launch/allocate/create) 성공 꼬리의 편성 ensure.
# 오너 확정 ②a/⑩B: 상비편성(B)이 부서 팀 admission 의 정본이다 — 여기에 티켓 게이트를 넣지
# 않는다(티켓 체계 bootstrap ③″는 수동 선언 레인 전용으로 무변경 존치). fail-open 계약:
# 실패·모듈 부재·행이 부서 생성을 절대 깨지 않는다 — ensure 는 노드 부착(역할당 최대 200s)
# 을 포함해 수 분을 점유할 수 있으므로 **백그라운드**로 착수한다(동기 호출은 allocate/create
# 의 stdout name 파싱(Tauri)을 그만큼 지연시켜 '생성 불파괴' 계약을 UX 층에서 깬다).
# loud 채널: formation 자체의 feed 표면화(침묵 금지 C6) + 부서 로그의 formation.log +
# 착수 1줄(stderr). 미착수(모듈 부재)도 1줄 남긴다 — 주기 심박(base 스케줄 ⓑ)이 후속 수렴.
# --force-surface 금지(주기 잡 스팸 계약 javis_formation.py _surface 주석) · CYS_STATE_DIR
# 무재설정(싱글플라이트 락 불변식 — formation.py _state_root 주석).
formation_ensure_async(){
  local name="$1" sock="$2" fm log logdir
  fm="${CYS_PACK_DIR:-$PACK_DEFAULT}/bin/javis_formation.py"
  if [ ! -f "$fm" ]; then
    echo "[cys-dept] WARN: $name 편성 ensure 생략(javis_formation.py 부재) — base 스케줄 심박이 후속 수렴" >&2
    return 0
  fi
  # ★SF-2(P3 수정 라운드): 로그 dir 부재 형상에서 >>"$log" 실패로 서브셸이 침묵 사망하면 아래
  #   '착수' 1줄이 거짓 주장이 된다 — mkdir 선행·불가 시 /dev/null 폴백(로그만 포기·실행은 보장.
  #   심박이 후속 수렴하므로 로그 소실은 저위험).
  logdir="$(dept_logdir "$name")"; log="$logdir/formation.log"
  mkdir -p "$logdir" 2>/dev/null || log=/dev/null
  ( python3 "$fm" ensure --socket "$sock" --json >>"$log" 2>&1 || true ) &
  disown 2>/dev/null || true
  echo "[cys-dept] $name 상비편성 ensure 착수(백그라운드·fail-open) — 로그: $log" >&2
}

# ★기능2 프리미티브: 부서 state 디렉토리(대화기억 transcripts.db) 격리(mv→trash). down 기본 체인 뒤
# --purge-state에서만 호출. 삭제(rm) 아닌 격리라 왕복 복원 가능(mv 역방향). 반환 0=격리 완료 또는
# 대상 없음(우아·no-op), 비0=부적격명·경로 불일치·사용 중·mv 실패·잔존(강행 금지). preflight stop-and-report 내장.
dept_purge_state(){
  local name="$1"
  # ★F2(reviewer1): traversal 차단 — 부서명에 / 또는 .. 가 있으면 pwd -P가 네임스페이스 밖 실경로를
  # 산출(문자열 동등 가드는 통과)→mv 대참사. 진입부에서 거부한다(빈 이름·경로구분자·상위참조 불허).
  case "$name" in
    */*|*..*|"") echo "[cys-dept] purge-state: 부적격 부서명('"'"'$name'"'"') — 경로 구분자·상위참조 불허" >&2; return 2 ;;
  esac
  case "$(uname -s 2>/dev/null)" in
    MINGW*|MSYS*|CYGWIN*)
      echo "[cys-dept] purge-state: Windows named pipe 부서는 state 형제 디렉토리 없음 — skip($name)" >&2
      return 0 ;;
  esac
  local sd; sd="$(dept_state "$name")"
  local expect="$HOME/.local/state/cys-dept-$name"
  if [ "$sd" != "$expect" ]; then
    echo "[cys-dept] purge-state: state 경로 불일치(got=$sd expect=$expect) — 중단(오해석 방지)" >&2
    return 3
  fi
  if [ ! -d "$sd" ]; then
    echo "[cys-dept] purge-state: state 디렉토리 없음($sd) — 격리 대상 없음(no-op)"
    return 0
  fi
  local rp; rp="$(cd "$sd" 2>/dev/null && pwd -P)" || rp="$sd"
  # ★F2 belt: realpath 재대조 — 심링크·경합으로 rp가 cys-dept-<name> 밖이면 거부(mv 전 최종 방어).
  if [ "$(basename "$rp")" != "cys-dept-$name" ]; then
    echo "[cys-dept] purge-state: realpath 이탈($rp) — cys-dept-$name 아님, 중단" >&2
    return 3
  fi
  if command -v lsof >/dev/null 2>&1; then
    if lsof +D "$rp" >/dev/null 2>&1; then
      echo "[cys-dept] purge-state: $rp 사용 중(열린 파일 존재) — 격리 중단(데몬 잔존 의심·강행 금지). down 재확인 후 재시도." >&2
      return 4
    fi
  fi
  local sz mt
  sz="$(du -sh "$rp" 2>/dev/null | cut -f1)"
  mt="$(stat -c '%y' "$rp" 2>/dev/null || stat -f '%Sm' "$rp" 2>/dev/null || echo '?')"
  echo "[cys-dept] purge-state: 대상=$name 경로=$rp 크기=${sz:-?} 최종수정=${mt}"
  local ts trash
  ts="${CYS_TRASH_STAMP:-$(date +%s)}"
  trash="$TRASH_ROOT/$name-$ts"
  mkdir -p "$trash" || { echo "[cys-dept] purge-state: trash 생성 실패($trash)" >&2; return 5; }
  if ! mv "$rp" "$trash/state" 2>/dev/null; then
    echo "[cys-dept] purge-state: 격리 mv 실패($rp → $trash/state)" >&2
    return 5
  fi
  if [ -d "$sd" ]; then
    echo "[cys-dept] purge-state: 원위치 잔존($sd) — 격리 미완(FAIL)" >&2
    return 6
  fi
  echo "[cys-dept] purge-state: $name state 격리 완료 → $trash/state (복구=mv 역방향·${CYS_TRASH_TTL_DAYS:-14}일 후 reap 소거)"
  return 0
}

# RC-15(D7): 부서 로그·상태 디렉토리 — Windows named pipe 소켓(\\.\pipe\...)은 dirname/디렉토리 개념이
# 없어(RC-4 파생) mkdir·로그 경로가 깨진다. 실 디렉토리로 분리:
#   Windows = %LOCALAPPDATA%\cys\cys-dept-<name> — ★RC-13 state_dir 슬러그와 **동일 규약**(pipe_slug
#     `\\.\pipe\cys-dept-<name>`→`cys-dept-<name>`)이라 로그+transcripts.db+feed.jsonl가 한 폴더로 모임.
#   unix = 소켓 부모(기존 dirname($sock)=~/.local/state/cys-dept-<name>·무회귀).
dept_logdir(){
  case "$(uname -s 2>/dev/null)" in
    MINGW*|MSYS*|CYGWIN*) echo "${LOCALAPPDATA:-$HOME/AppData/Local}/cys/cys-dept-$1" ;;
    *) dirname "$(dept_sock "$1")" ;;
  esac
}

# RC-6: OS중립 graceful kill — unix=SIGTERM→대기→SIGKILL, Windows(MSYS/Git-Bash)=taskkill(트리·강제).
# Windows 프로세스는 unix 시그널을 안 받으므로 kill/kill -9가 무효 → taskkill //PID //T //F로 분기
# (MSYS는 `/PID`를 경로로 변환하므로 `//PID` 형식 사용).
graceful_kill(){
  local pid="$1"
  case "$(uname -s 2>/dev/null)" in
    MINGW*|MSYS*|CYGWIN*) taskkill //PID "$pid" //T //F >/dev/null 2>&1 || true ;;
    *)
      kill "$pid" 2>/dev/null || true
      for _i in 1 2 3 4 5 6; do kill -0 "$pid" 2>/dev/null || break; sleep 0.3; done
      kill -0 "$pid" 2>/dev/null && kill -9 "$pid" 2>/dev/null || true ;;
  esac
}

# ── ★D3(i) 부서명 검증 (v4 수리 스펙 — `launch --help` 유령부서→껍데기 CEO 승격 실사고 봉합) ──
# 화이트리스트 ^[A-Za-z0-9][A-Za-z0-9_-]*$ — '.' 불허(Windows pipe_slug(state.rs:1133-1139)가 '.'을
# 소거해 점만 다른 두 부서의 상태 디렉토리가 병합되는 격리 붕괴 봉합)·'-' 선두 불허(옵션 오파싱)·
# 최대 40자(macOS unix 소켓 104B 한계 여유)·LC_ALL=C(로케일 무관 결정론).
# 거부 exit=2(기존 usage 계열과 통일) 고정 — ★재사용 금지 집합={1,3,4,5,6,7,8,9}
# (1=기동실패·3/4=카탈로그·5=계정·6=시드·7=단일소유·8=cap/미등재·9=rotate 미응답 — GUI 분기 오동작 방지).
# ★중대(2026-08-22 검증리뷰): 종전 `printf | grep -Eq` 는 **줄 단위** 판정이라 여러 줄 중 한 줄만
#   맞아도 성립했다 — `$'abc\nrm -rf /'`·`$'\nabc'`·`$'abc\n'`·`$'x\nAAAA'` 가 전부 통과했다.
#   반면 발급기 `javis_bootstrap.py` 는 `DEPT_NAME_RE.fullmatch()` 로 **문자열 전체**를 요구한다 →
#   생성기는 만들고 발급기는 영영 거부하는 부서(=티켓 없는 단독 각성)가 남았다. 그 이름은 경로에도
#   들어간다(`<dept>.ticket` · 소켓/팩 `cys-dept-$name`).
#   수정: bash `[[ =~ ]]`(regexec · REG_NEWLINE 미사용)로 바꿔 `^`·`$` 가 **문자열 전체**를 앵커하게
#   한다 — 개행 축만 땜질하는 게 아니라 '줄 단위 판정'이라는 결함 부류 자체를 제거한다. 서브셸로
#   감싼 이유는 LC_ALL=C 를 이 판정에만 국한하기 위함이다(복합 명령엔 assignment prefix 불가).
#   외부 프로세스 2개(printf|grep)도 사라진다. bash 3.2(macOS 기본)에서 동작 확인.
#   ※ 패턴 리터럴 `[A-Za-z0-9][A-Za-z0-9_-]{0,39}` 는 그대로 유지한다 — javis_bootstrap.py 의
#     소스 대조 self-test 가 이 부분 문자열의 실재로 두 구현의 동기화를 감시한다.
dept_name_ok(){ ( LC_ALL=C; [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9_-]{0,39}$ ]] ); }
# 거부 진단 단일 지점: $1=name, $2=해당 동사 usage 1줄(빈값=무진단·비0 반환만 — passthrough 판별용),
# $3=추가 안내(rotate '비정형 등재' 등). 불합격=stderr 진단(+usage 1줄 병기)+exit 2.
validate_dept_name(){
  local name="$1" u="${2:-}" hint="${3:-}"
  dept_name_ok "$name" && return 0
  [ -n "$u" ] || return 1
  echo "[cys-dept] 부적격 부서명('$name') — 허용 ^[A-Za-z0-9][A-Za-z0-9_-]*$ (최대 40자·빈이름/'.'포함/'-'선두 불가)" >&2
  echo "usage: cys-dept $u" >&2
  if [ -n "$hint" ]; then echo "[cys-dept] $hint" >&2; fi
  exit 2
}
# ★A2 slug-fold 중복 거부: fold=소문자화+'.' 제거 — Windows pipe_slug 정규화·대소문자 불감 FS와 정합
# (fold가 같으면 win에서 상태 디렉토리(transcripts.db·feed.jsonl)가 병합된다). 거부 = fold(신규)==
# fold(기존 등재명) ∧ 신규≠기존(바이트 동일 자기 항목 제외 — 자기 제외가 없으면 GUI 복원 재-launch·
# rotate 재귀가 전부 거부된다). 회귀 핀: 기존명 재-launch/rotate 통과. 검사 지점=reg_upsert 진입부와
# allocate 예약 사후 assert 공통(+launch는 부작용-이전 조기 호출). 기존 충돌 쌍 가시화는 preflight 소관.
dept_name_fold(){ printf '%s' "$1" | LC_ALL=C tr 'A-Z' 'a-z' | tr -d '.'; }
reject_slug_collision(){
  local name="$1" fold ex
  fold="$(dept_name_fold "$name")"
  # 파이프 대신 heredoc(reap 관용) — 파이프 서브셸이면 exit 2가 스크립트를 못 끝낸다.
  while IFS= read -r ex; do
    [ -n "$ex" ] || continue
    [ "$ex" = "$name" ] && continue          # 자기 항목(바이트 동일) — 재-launch/rotate 통과
    if [ "$(dept_name_fold "$ex")" = "$fold" ]; then
      echo "[cys-dept] 부서명 slug 충돌: '$name' ↔ 기존 등재 '$ex' (fold='$fold' 동일 — win 상태 디렉토리 병합 위험) — 거부(개명 후 재시도)" >&2
      exit 2
    fi
  done <<EOF
$(reg_names)
EOF
}
# cmd 위치 --help/-h 전용 usage(stdout) — name 위치의 --help는 usage가 아니라 검증 거부(exit 2)다.
usage(){
  cat <<'USAGE'
usage: cys-dept <verb> ...
  cys-dept launch <name>                        부서 데몬 spawn+ACL 시드+등재 (name: ^[A-Za-z0-9][A-Za-z0-9_-]*$·최대 40자)
  cys-dept allocate                             lowest-unused dept-N 자동 발급·기동
  cys-dept create <catalog-key>                 카탈로그 기반 완전 자동 부서 생성
  cys-dept down <name> [--purge-state]          teardown(+state 격리)
  cys-dept down-sock <socket>                   socket 기준 teardown
  cys-dept rotate <name>                        버전 스큐 세대교체(재기동·폐기 아님)
  cys-dept reap [--dry]                         죽은 등록·유휴 부서 회수
  cys-dept promote-ceo                          CEO 승격(오너 지명)
  cys-dept promote-if-pending [--request-only]  보류 승격 해소(알림만=--request-only)
  cys-dept list                                 부서명 목록
  cys-dept sock <name>                          부서 소켓 경로 출력
  cys-dept <name> -- <cmd>                      부서 컨텍스트(CYS_SOCKET+CYS_PACK_DIR)로 명령 실행
USAGE
}

reg_init(){ [ -f "$REG" ] || { mkdir -p "$(dirname "$REG")"; printf '{"depts":{}}\n' > "$REG"; }; }
reg_count(){ reg_init; python3 -c "import json,sys;print(len(json.load(open(sys.argv[1]))['depts']))" "$REG" | tr -d '\r'; }
# ★CRLF 위생(2026-08-16 win T3-ng3 실증): Windows 임베디드 python 의 stdout 은 텍스트 모드라
#   줄끝이 \r\n 이다. $(...) 캡처는 MSYS bash 가 \r 을 벗겨 안전(allocate 상시 green 이 실증)하나
#   파이프 소비자(`reg_names | grep -Fxq -- name` — rotate 등재 게이트 L:rotate·TOCTOU 재확인)는
#   'name\r' 을 못 맞춰 등재명을 미등재(exit 8)로 오판했다 — 단일 지점에서 \r 을 소거한다.
# ★경로는 -c 문자열에 내장하지 말고 argv 로 넘긴다(2026-08-16 T3-ng3 2차 실증): MSYS 는 네이티브
#   실행 인자의 POSIX 경로만 Windows 경로로 자동 변환한다 — -c 코드 안의 '/c/Users/…' 는 미변환이라
#   Windows python 이 FileNotFoundError 로 죽고, 파이프 소비자(rotate 등재 게이트)·reg_count 캡처
#   ("부서 수" 산정·down 의 강등 판정)가 전부 빈 값이 됐다(win 잠복 결함).
reg_names(){ reg_init; python3 -c "import json,sys;[print(k) for k in json.load(open(sys.argv[1]))['depts']]" "$REG" | tr -d '\r'; }

# ★A2(SURVEY B3): 등재(SOT=depts.json)에 없는데 **소켓 디렉터리만** 남은 부서를 stderr 로 고지한다.
#   정상 teardown 은 상태 디렉터리를 TRASH_ROOT 로 격리하므로 이 형상은 **비정상 종료 잔재**다.
#   방치하면 자원 게이트가 유령 소켓의 응답을 타임아웃까지 기다린다(실측 5.1s/개 — A3-c).
#   ★stdout 은 건드리지 않는다: 심박·fan-out 소비자(`for d in $(cys-dept list)`)의 계약이
#   stdout 이라, 경고를 거기 섞으면 유령 이름이 부서명으로 소비된다. 경고는 stderr 전용이다.
#   Windows named pipe(`\\.\pipe\cys-dept-<n>`)는 파일이 아니라 glob 대상이 아니므로 unix 한정
#   (dept_sock:47 의 분기 관례 재사용 — Windows 거동 무변경).
dept_warn_unregistered_socks(){
  case "$(uname -s 2>/dev/null)" in
    MINGW*|MSYS*|CYGWIN*) return 0 ;;
  esac
  local names d n
  names="${1-}"
  for d in "$HOME"/.local/state/cys-dept-*/; do
    [ -d "$d" ] || continue
    n="${d%/}"; n="${n##*/cys-dept-}"
    [ -n "$n" ] || continue
    if printf '%s\n' "$names" | grep -Fxq -- "$n"; then continue; fi
    echo "[cys-dept] 미등재 소켓 디렉터리: $n (${d%/}) — depts.json 에 없다(비정상 종료 잔재 가능). 자원 게이트 지연의 원인이니 정리하라." >&2
  done
  return 0
}
# reg_upsert/reg_remove: 동시 부서 운용 시 lost-update 방지 — fcntl.flock으로 RMW 직렬화 +
# temp+os.replace 원자 교체(읽는 쪽이 부분 파일을 보지 않음). macOS엔 flock(1) CLI가 없어 python fcntl 사용.
reg_upsert(){ reject_slug_collision "$1"; reg_init; python3 - "$REG" "$1" "$2" "$3" <<'PY'
import json,sys,os
try:
    import fcntl
    def _lk(f): fcntl.flock(f, fcntl.LOCK_EX)
    def _ulk(f): fcntl.flock(f, fcntl.LOCK_UN)
except ImportError:  # RC-6 Windows: fcntl 부재 → msvcrt 바이트락(파일 닫힘 시 해제·_ulk no-op 안전)
    import msvcrt
    def _lk(f):
        try: msvcrt.locking(f.fileno(), msvcrt.LK_LOCK, 1)
        except OSError: pass
    def _ulk(f): pass
p,n,s,k=sys.argv[1:5]
lf=open(p+'.lock','w'); _lk(lf)
try:
    try: d=json.load(open(p))
    except Exception: d={'depts':{}}
    # F2(codex#2): full-replace 대신 merge — 기존 메타(display_name/account/mission_key) 보존.
    # launch 재진입 시 create가 심은 메타 소실 방지. 신규 엔트리는 3필드만(하위호환).
    e=d.setdefault('depts',{}).setdefault(n,{})
    e.update({'socket':s,'pack_dir':k,'role':'dept-master'})
    tmp=p+'.tmp.%d'%os.getpid()
    with open(tmp,'w') as f: json.dump(d,f,ensure_ascii=False,indent=2); f.flush(); os.fsync(f.fileno())
    os.replace(tmp,p)
finally: _ulk(lf)
PY
}
reg_remove(){ reg_init; python3 - "$REG" "$1" <<'PY'
import json,sys,os
try:
    import fcntl
    def _lk(f): fcntl.flock(f, fcntl.LOCK_EX)
    def _ulk(f): fcntl.flock(f, fcntl.LOCK_UN)
except ImportError:  # RC-6 Windows: fcntl 부재 → msvcrt 바이트락(파일 닫힘 시 해제·_ulk no-op 안전)
    import msvcrt
    def _lk(f):
        try: msvcrt.locking(f.fileno(), msvcrt.LK_LOCK, 1)
        except OSError: pass
    def _ulk(f): pass
p,n=sys.argv[1:3]
lf=open(p+'.lock','w'); _lk(lf)
try:
    try: d=json.load(open(p))
    except Exception: d={'depts':{}}
    d.setdefault('depts',{}).pop(n,None)
    tmp=p+'.tmp.%d'%os.getpid()
    with open(tmp,'w') as f: json.dump(d,f,ensure_ascii=False,indent=2); f.flush(); os.fsync(f.fileno())
    os.replace(tmp,p)
finally: _ulk(lf)
PY
}
# reg_set_meta: 기존 엔트리에 display_name·account·mission_key 를 merge(socket/pack_dir/role 보존).
# reg_upsert 시그니처 불변(launch 회귀0) — ＋부서 자동화(cys-dept create)용 신설. flock RMW·원자교체.
reg_set_meta(){ reg_init; python3 - "$REG" "$1" "$2" "$3" <<'PY'
import json,sys,os
try:
    import fcntl
    def _lk(f): fcntl.flock(f, fcntl.LOCK_EX)
    def _ulk(f): fcntl.flock(f, fcntl.LOCK_UN)
except ImportError:  # RC-6 Windows: fcntl 부재 → msvcrt 바이트락(파일 닫힘 시 해제·_ulk no-op 안전)
    import msvcrt
    def _lk(f):
        try: msvcrt.locking(f.fileno(), msvcrt.LK_LOCK, 1)
        except OSError: pass
    def _ulk(f): pass
p,n,disp,acct=sys.argv[1:5]
lf=open(p+'.lock','w'); _lk(lf)
try:
    try: d=json.load(open(p))
    except Exception: d={'depts':{}}
    e=d.setdefault('depts',{}).get(n)
    if e is None:   # ★fail-closed(CSO GAP①): create가 base 엔트리 선기록 → 부재=버그 → no-op 말고 에러
        sys.stderr.write("reg_set_meta: 엔트리 부재 %s — fail-closed(예약 base 미기록=버그)\n"%n); sys.exit(1)
    e['display_name']=disp; e['account']=acct   # mission_key는 예약시 원자기록(중복 set 제거)
    tmp=p+'.tmp.%d'%os.getpid()
    with open(tmp,'w') as f: json.dump(d,f,ensure_ascii=False,indent=2); f.flush(); os.fsync(f.fileno())
    os.replace(tmp,p)
finally: _ulk(lf)
PY
}

# 부서 데몬 ACL 시드 — external(CEO·타 부서 노드)→worker 차단. fail-closed: 없으면 격리 붕괴이므로 항상 시드.
#
# ★결함#6-a(오너 실측): GUI에서 부서 워커 pane에 타이핑하면 `acl denied: external → worker
#   (pack/acl.json)`로 막혔다. 원인은 아래 `external→worker* deny`와 팩 acl.json `_doc`의
#   external 정의("pane 밖 프로세스(오너 셸·Tauri 등)")다 — **오너의 GUI가 external 등급**이라
#   자기 부서 워커에게 입력을 못 넣었다. 오너 절대규칙: "cys-terminal의 모든 노드 프롬프트 창을
#   오너가 컨트롤할 수 있어야 한다".
# ★수정: `owner` 신원 등급을 규칙 배열 **맨 앞**에 둔다 — cysd `eval_acl_rules`(handlers.rs)는
#   `return rule["allow"]` 로 **첫 매칭에서 확정**하기 때문이다. 다만 오너 순회는 `from` 을
#   **exact 비교**(`from_exact=true`)하고 명시 owner 규칙이 없으면 **허용이 기본**(`unwrap_or(true)`)
#   이므로, 우리 규칙을 실제로 가릴 수 있는 것은 오너가 직접 쓴 또 다른 `from:"owner"` 규칙뿐이다
#   (`{"from":"*"}` 류 와일드카드는 오너를 잠그지 못한다).
# ★보존: CEO·타 부서 노드가 부서장을 건너뛰고 워커를 직접 조향하는 것은 계속 막는다(부서 자율성)
#   — external→worker* deny·reviewer-*→worker* deny·external→master allow 는 불변이다.
# ★데몬측 판정(실측 — handlers.rs `caller_is_owner`/`operator_token_ok`): 경로 검사가 아니라
#   **operator_token** 이다. 데몬이 기동 시 발급해 `state_dir/operator.token`(unix 0600)에 쓴
#   값을 요청에 실은 발신자만 owner 이며, 추가로 **그 데몬의** 어느 pane 에도 귀속되지 않아야
#   한다(`from_sid.is_none()`). 붙이는 지점은 Tauri 백엔드 단 한 곳이고 공용 `cys` CLI 는 어느
#   경로에서도 붙이지 않는다.
# ★★사정거리(치명 F1 정정 · 과대선전 금지): `from_sid.is_none()` 은 **그 데몬의 pane 만** 배제한다
#   — 이는 사실상 `external` 의 정의 그 자체다. 따라서 `external→worker* deny` 가 겨냥한 적대자
#   (본부 데몬의 CEO·master, 타 부서 노드)는 **애초에 그 부서 데몬의 pane 이 아니므로 이 조건을
#   자동으로 만족**한다. 토큰 파일은 같은 UID 면 읽히므로 그들이 raw RPC 로 붙이면 우회가 성립한다.
#   즉 **이 등급은 보안 경계가 아니라 거버넌스 구분**이다(강화 후보 3종은 데몬 담당 축에서 조사 후
#   전부 기각 — 부서 데몬은 앱 번들이 아니라 PATH/homebrew 로 해소돼 실행경로 판정이 이 레인에서
#   성립하지 않고, 메모리 nonce 는 데몬 재시작 시 오너 자신을 잠근다). 성립하지 않는 방어를
#   성립한다고 쓰지 않는다 — 실제로 닫히는 것은 "지침을 따르는 정상 노드가 오너 입력으로 승격되는
#   경로"뿐이고, 승격 판정은 `acl.owner_granted` 이벤트로 감사된다.
# ★하위호환: owner 규칙이 없는 기존 ACL 은 데몬이 2단 평가의 2차(종전 신원)로 그대로 흘리고,
#   구 데몬(토큰 미지원)에서는 발신 role 이 "owner" 가 될 수 없어 이 규칙이 영영 미매칭이다 —
#   양방향 모두 거동 변화 0이다. 이 파일은 ACL 시드(데이터)만 담당한다.
#
# ★seed-once + additive 마이그레이션(2026-08-22 master 지시 — 오너 정책 보존):
#   종전엔 무조건 `cat >` 로 덮어써, `src/pack.rs` W-ACL(2026-08-01 오너 승인)이 acl.json 을
#   **User 등급**으로 승격해 오너 정책을 보존하는 계약을 이 함수가 우회하고 있었다(부서 팩
#   acl.json 손편집이 다음 lifecycle 호출마다 소실). 이제:
#     · 파일 **부재** → 전체 시드(현행 동작 보존).
#     · 파일 **존재** → 덮어쓰지 않는다. owner 규칙이 없을 때만 **맨 앞에 추가**하고 나머지
#       규칙·필드는 텍스트 그대로 보존한다(재직렬화하지 않는다 = 오너의 서식·주석성 필드 무손실).
#       이미 있으면 무동작(멱등).
#   기존 부서도 다음 lifecycle 호출(launch·allocate·create·rotate)에서 owner 규칙을 받는다.
seed_acl(){
  local pk="$1"; mkdir -p "$pk"
  if [ -f "$pk/acl.json" ]; then
    acl_migrate_owner "$pk/acl.json"
    return 0
  fi
  cat > "$pk/acl.json" <<'JSON'
{
  "_doc": "부서 데몬 ACL — CEO·타 부서 노드는 워커 직접 조향 불가(부서장 master 경유), 오너 GUI는 전 노드 허용. 규칙은 위에서부터 첫 매칭 승리. cys-dept 시드(파일 부재 시 전체 시드 · 이미 있으면 owner 규칙만 맨 앞에 추가하고 나머지는 보존한다 — 오너 정책 무손실). from 신원 등급 'owner' = 오너 GUI(Tauri) 세션. 데몬이 기동 시 발급한 토큰(state_dir/operator.token·0600)을 요청에 실은 발신자이며, 그 데몬의 어느 pane 에도 귀속되지 않아야 한다. 매칭은 from 문자열 정확 일치만 인정하고(글롭 미적용), 매칭되는 owner 규칙이 없으면 허용이 기본이다 — 오너를 막는 유일한 방법은 {\"from\":\"owner\", …, \"allow\":false} 명시다. ★이 등급은 보안 경계가 아니라 거버넌스 구분이다: 같은 UID 로 토큰 파일을 읽을 수 있는 프로세스는 — 다른 데몬의 노드를 포함해 — raw RPC 로 참칭할 수 있다(단일 UID 신뢰 모델의 알려진 한계). 공용 cys CLI 는 토큰을 붙이지 않으므로 지침을 따르는 정상 노드는 이 등급에 오지 않는다. 판정을 뒤집은 승격은 acl.owner_granted 이벤트로 감사된다. 'external'=pane 밖 프로세스(오너 셸 등). '(pane)'=역할 없는 pane.",
  "default": "allow",
  "rules": [
    { "from": "owner", "to": "*", "allow": true,
      "_why": "오너 직접 입력(GUI)은 전 노드 허용 — 오너는 external 이 아니다" },
    { "from": "external", "to": "worker*", "allow": false },
    { "from": "reviewer-*", "to": "worker*", "allow": false },
    { "from": "external", "to": "master", "allow": true }
  ]
}
JSON
}

# 기존 acl.json 에 owner 규칙만 **추가**한다(덮어쓰기 금지 · 멱등 · fail-open).
# ★무손실 근거: json.loads 로 **판정만** 하고 쓰기는 원문 텍스트에 `"rules": [` 직후 삽입이다 —
#   재직렬화하지 않으므로 오너의 들여쓰기·키 순서·추가 필드가 바이트 그대로 남는다.
# ★안전: 삽입 결과를 다시 파싱해 (a)유효 JSON (b)rules[0]=owner (c)**나머지 규칙이 원본과 완전
#   동일** 인지 검증한 뒤에야 임시파일→`os.replace` 원자 교체한다(반쪽 쓰기 0·원본 모드 승계).
# ★fail-open: python3 부재·JSON 손상·구조 예외·쓰기 실패 등 **어떤 실패에서도 원본을 건드리지
#   않고** stderr 경고 1줄만 남긴 뒤 계속한다(부서 생성 불파괴 — 티켓 발급과 동일 규약).
#   ACL 평가는 데몬에서 파일 부재·파싱 실패 시 fail-OPEN 이라 동결 리스크도 없다.
# exit 규약(내부): 0=추가함 · 10=이미 있음(무동작) · 그 외=미변경(경고).
acl_migrate_owner(){
  local f="$1" rc=0 out
  # heredoc 관례는 이 파일 기존 형태(resolve_default_base)와 동일 — 닫는 `)` 는 PY 종단 뒤에 온다.
  out="$(python3 - "$f" 2>&1 <<'PY'
import json,os,re,stat,sys,tempfile
p=sys.argv[1]
try:
    with open(p,encoding="utf-8") as fh: text=fh.read()
except OSError as e:
    sys.stderr.write("읽기 실패(%s)"%e); sys.exit(3)
try: d=json.loads(text)
except Exception as e:
    sys.stderr.write("JSON 손상(%s)"%e); sys.exit(3)          # 원본 불변
if not isinstance(d,dict): sys.stderr.write("루트가 객체 아님"); sys.exit(3)
rules=d.get("rules")
if not isinstance(rules,list): sys.stderr.write("rules 배열 부재/형식오류"); sys.exit(3)
# 멱등 판정 — ★적대검증 ⑥: '존재하냐'가 아니라 '**첫 번째냐**'로 나눈다.
#   idx==0  → 정상(무동작·무음)  ·  idx>0 → 무동작이되 **가시화**(exit 11 → stderr 경고).
#   재배열하지 않는 근거는 아래 shell 의 exit 11 분기 주석에 있다 — 오너 정책 무손실.
#   ※이 heredoc 은 $( ) 안에 있다 — 본문에 짝 없는 닫는 괄호를 쓰면 bash 파서가 깨진다(실측).
_own=[i for i,r in enumerate(rules) if isinstance(r,dict) and r.get("from")=="owner"]
if _own:
    if _own[0]==0: sys.exit(10)
    sys.stderr.write("owner 규칙이 %d번째(0-based, 총 %d규칙)"%(_own[0],len(rules))); sys.exit(11)
m=re.search(r'"rules"\s*:\s*\[', text)
if not m: sys.stderr.write("rules 배열 여는 위치 탐색 실패"); sys.exit(3)
ins=('\n    { "from": "owner", "to": "*", "allow": true,'
     '\n      "_why": "오너 직접 입력(GUI)은 전 노드 허용 — 오너는 external 이 아니다" }')
new=text[:m.end()]+ins+("," if rules else "")+text[m.end():]   # 빈 배열이면 트레일링 콤마 금지
try: nd=json.loads(new)
except Exception as e:
    sys.stderr.write("삽입 결과가 무효 JSON(%s)"%e); sys.exit(4)   # 원본 불변
nr=nd.get("rules")
if not isinstance(nr,list) or len(nr)!=len(rules)+1 or nr[0].get("from")!="owner" or nr[1:]!=rules:
    sys.stderr.write("사후 검증 실패(기존 규칙 보존 불확정)"); sys.exit(4)   # 원본 불변
dirn=os.path.dirname(p) or "."
fd,tmp=tempfile.mkstemp(dir=dirn,prefix=".acl.",suffix=".tmp")
try:
    with os.fdopen(fd,"w",encoding="utf-8",newline="") as fh:
        fh.write(new); fh.flush(); os.fsync(fh.fileno())
    try: os.chmod(tmp, stat.S_IMODE(os.stat(p).st_mode))       # 원본 퍼미션 승계
    except OSError: pass
    os.replace(tmp,p)                                          # 원자 교체
except Exception as e:
    try: os.unlink(tmp)
    except OSError: pass
    sys.stderr.write("원자 교체 실패(%s)"%e); sys.exit(5)      # 원본 불변
sys.exit(0)
PY
)" || rc=$?
  case "$rc" in
    0)  echo "[cys-dept] ACL 마이그레이션: owner 규칙 추가(맨 앞) — 기존 규칙·필드 보존: $f" >&2 ;;
    10) : ;;   # owner 규칙이 이미 **맨 앞** — 무동작·무출력(멱등·로그 소음 금지)
    # ★적대검증 ⑥: owner 규칙이 존재하되 첫 번째가 아님 → **무동작 + 경고**(재배열 금지).
    #   재배열하지 않는 근거(실측): 데몬은 오너 순회에서 `from` 을 **exact 비교**하고
    #   (`eval_acl_rules(..., from_exact=true)`), 명시 owner 규칙이 하나도 매칭 안 되면
    #   **허용이 기본**이다(`.unwrap_or(true)`). 따라서 `{"from":"*"}` 류 와일드카드는 오너를
    #   잠그지 못하고, 우리 규칙을 실제로 가릴 수 있는 것은 **오너가 직접 쓴 또 다른
    #   `from:"owner"` 규칙뿐**이다 — 그건 오너의 명시적 의사표시이므로 조용히 순서를 바꾸면
    #   오너 정책을 덮어쓰는 꼴이 된다(이 함수의 '무손실' 원칙과 정면 충돌). 침묵만 없앤다.
    11) echo "[cys-dept] WARN: ACL owner 규칙이 맨 앞이 아니다($f · $out) — 앞선 명시 from=\"owner\" 규칙이 있으면 그쪽이 먼저 확정된다(첫 매칭 승리). 오너 정책 보존을 위해 자동 재배열은 하지 않는다 — 오너 GUI 입력이 막히면 순서를 직접 확인하라." >&2 ;;
    *)  echo "[cys-dept] WARN: ACL owner 규칙 추가 실패 — **원본 무변경**으로 진행($f). 오너 GUI의 워커 pane 입력이 막히면 이 파일 rules 맨 앞에 { \"from\": \"owner\", \"to\": \"*\", \"allow\": true } 를 수동 추가하라. (사유: $(printf '%s' "$out" | tr '\n' ' ' | cut -c1-200))" >&2 ;;
  esac
  return 0
}

# F1(codex#1·verdict-D): 부서 pack 에 agents.json 을 명시 시드 — claude.cmd 의 CLAUDE_CONFIG_DIR 을
# 해당 account dir 로 **직접 치환**(하드코딩). 이렇게 하면 cysd 임베드 버전·CYS_ACCOUNT_DIR 전파(patch2)
# 에 비의존하여 계정격리가 완결된다(rebuild 전 deployed 구 cysd 로도 동작). 가드 str-replace + 쓰기후
# json 검증 + 리터럴 미발견 시 fail-closed(비격리 시드 금지). 멱등(재시드 시 account 만 갱신).
seed_agents_account(){
  local pk="$1" acct_dir="$2"
  local src="${CYS_PACK_DIR:-$HOME/.cys/pack}/agents.json"
  mkdir -p "$pk"
  python3 - "$src" "$pk/agents.json" "$acct_dir" <<'PY'
import json,sys,os,re
src,dst,acct=sys.argv[1:4]
d=json.load(open(src,encoding="utf-8"))                 # RC-6(T3): Windows cp1252 기본 회피(한글 UTF-8)
claude=d.get("claude") or {}
env=claude.get("env")
# RC-3 파급 수정: agents.json이 cmd+env 구조가 되면서 CLAUDE_CONFIG_DIR이 cmd 리터럴→env 맵으로 이동했다.
# 신구조=env["CLAUDE_CONFIG_DIR"]를 account dir로 치환(계정 격리). 레거시(cmd 인라인 리터럴)는 하위호환 str-replace.
# 둘 다 없으면 fail-closed(비격리 시드 금지 — 기존 안전규약 유지).
if isinstance(env, dict) and "CLAUDE_CONFIG_DIR" in env:
    env["CLAUDE_CONFIG_DIR"]=acct
elif re.search(r'CLAUDE_CONFIG_DIR="[^"]*"', claude.get("cmd","")):
    claude["cmd"]=re.sub(r'CLAUDE_CONFIG_DIR="[^"]*"',
                         lambda m: 'CLAUDE_CONFIG_DIR="%s"'%acct, claude["cmd"], count=1)
else:
    sys.stderr.write("seed_agents_account: CLAUDE_CONFIG_DIR(env 맵/cmd 리터럴) 미발견 — abort(비격리 시드 금지)\n"); sys.exit(1)
tmp=dst+".tmp.%d"%os.getpid()
with open(tmp,"w") as f: json.dump(d,f,ensure_ascii=False,indent=2); f.flush(); os.fsync(f.fileno())
json.load(open(tmp))                                    # 쓰기후 파싱 검증
os.replace(tmp,dst)
PY
}

# ── G3(W3): launch(=rotate 공용)의 **계정격리 복원** ────────────────────────────
# ★결함(G3): `allocate`·`create` 는 데몬을 `CYS_ACCOUNT_DIR=<fork dir>` 로 띄우고 부서 팩
#   agents.json 의 CLAUDE_CONFIG_DIR 을 그 dir 로 시드했는데, **launch 는 둘 다 하지 않았다**.
#   그런데 `rotate`(버전 스큐 세대교체)는 launch 를 재귀 호출한다 — 즉 **rotate 한 번으로 계정격리가
#   조용히 풀렸다**(데몬 env 소실 + agents.json 이 base 를 가리키면 오너 config 공유 = F1 붕괴).
# ★복원 규약(3순위): ①명시 env(CYS_ACCOUNT_DIR) ②레지스트리 `account_dir`(create·allocate 기록)
#   ③부서 팩 agents.json 의 현재 CLAUDE_CONFIG_DIR. 유도값이 없으면 계정격리를 쓰지 않는 부서
#   (구 launch 산출)이므로 **무동작**(회귀 0).
reg_get_field(){ reg_init; python3 - "$REG" "$1" "$2" <<'PY'
import json,sys
p,n,f=sys.argv[1:4]
try: d=json.load(open(p))
except Exception: sys.exit(0)
e=(d.get('depts') or {}).get(n) or {}
print(e.get(f) or '')
PY
}

# 레지스트리 필드 1개 기록(flock RMW·원자 교체 — reg_set_meta 와 동일 규약, 임의 필드용).
reg_set_field(){ reg_init; python3 - "$REG" "$1" "$2" "$3" <<'PY'
import json,sys,os
try:
    import fcntl
    def _lk(f): fcntl.flock(f, fcntl.LOCK_EX)
    def _ulk(f): fcntl.flock(f, fcntl.LOCK_UN)
except ImportError:
    import msvcrt
    def _lk(f):
        try: msvcrt.locking(f.fileno(), msvcrt.LK_LOCK, 1)
        except OSError: pass
    def _ulk(f): pass
p,n,k,v=sys.argv[1:5]
lf=open(p+'.lock','w'); _lk(lf)
try:
    try: d=json.load(open(p))
    except Exception: d={'depts':{}}
    e=d.setdefault('depts',{}).setdefault(n,{})
    e[k]=v
    tmp=p+'.tmp.%d'%os.getpid()
    with open(tmp,'w') as f: json.dump(d,f,ensure_ascii=False,indent=2); f.flush(); os.fsync(f.fileno())
    os.replace(tmp,p)
finally: _ulk(lf)
PY
}

# 부서 팩 agents.json 이 실제로 가리키는 계정 dir(=시드된 값) 출력. 없으면 빈 출력.
pack_seeded_acct(){ python3 - "$1/agents.json" <<'PY'
import json,sys,re
try: d=json.load(open(sys.argv[1],encoding="utf-8"))
except Exception: sys.exit(0)
c=d.get("claude") or {}
env=c.get("env")
if isinstance(env,dict) and env.get("CLAUDE_CONFIG_DIR"):
    print(env["CLAUDE_CONFIG_DIR"]); sys.exit(0)
m=re.search(r'CLAUDE_CONFIG_DIR="([^"]*)"', c.get("cmd",""))
if m: print(m.group(1))
PY
}

# 이 부서의 계정 dir 유도(위 3순위). 빈 출력 = 계정격리 미사용 부서.
resolve_lane_acctdir(){
  local name="$1" pack="$2" v
  if [ -n "${CYS_ACCOUNT_DIR:-}" ]; then echo "$CYS_ACCOUNT_DIR"; return 0; fi
  v="$(reg_get_field "$name" account_dir 2>/dev/null | tail -1)"
  [ -n "$v" ] && { echo "$v"; return 0; }
  v="$(pack_seeded_acct "$pack" 2>/dev/null | tail -1)"
  [ -n "$v" ] && { echo "$v"; return 0; }
  return 0
}

# 계정격리 시드 검증(+자기치유). 0=격리 확정 또는 해당없음 · 1=격리 실패(호출부 fail-closed).
verify_lane_account_seed(){
  local pack="$1" acctdir="$2" cur
  [ -n "$acctdir" ] || return 0                 # 계정격리 미사용 부서 — 검증 대상 아님
  cur="$(pack_seeded_acct "$pack" 2>/dev/null | tail -1)"
  [ "$cur" = "$acctdir" ] && return 0           # 이미 정합(멱등)
  echo "[cys-dept] 계정격리 시드 재확립: agents.json CLAUDE_CONFIG_DIR '${cur:-none}' → '$acctdir'" >&2
  seed_agents_account "$pack" "$acctdir" || return 1
  cur="$(pack_seeded_acct "$pack" 2>/dev/null | tail -1)"
  [ "$cur" = "$acctdir" ]
}

# 부서 schedule 시드 — owner-progress-report(5/15분 보고)는 최상위(owner/CEO) 데몬만 돌려야 한다.
# pack install이 임베드 schedule.json(owner-보고 job)을 모든 pack에 깔므로, 부서 pack은 데몬 기동
# 후 빈 jobs로 덮어쓴다(데몬 30초 내 핫리로드 + install은 user-modified 보존으로 영속). 부서마다
# owner-보고가 N배 중복 실행되는 자원 낭비·노이즈 차단.
seed_schedule(){
  local pk="$1"; mkdir -p "$pk"
  printf '{\n  "_doc": "부서 데몬 schedule — owner 진행보고는 최상위만. cys-dept가 빈 jobs로 시드(중복 실행 방지).",\n  "jobs": []\n}\n' > "$pk/schedule.json"
}

# 부서 데몬은 첫 기동 시 pack install(수백 파일)로 listening까지 지연될 수 있어 폴링 간격을 둔다(최대 ~12s).
ready(){ local s="$1" i; for i in $(seq 1 120); do CYS_SOCKET="$s" "$CYS" ping >/dev/null 2>&1 && return 0; sleep 0.1; done; return 1; }

# allocate 계정격리(Fix1'): 기본계정 base config dir 해석. 카탈로그 accounts 맵 우선(있으면), 없으면
# ~/.cys/claude-<account> 규약 fallback. 항상 경로를 산출(빈 문자열이면 호출부가 fail-closed).
resolve_default_base(){
  local acct="$1" cat="${CYS_DEPT_CATALOG:-$HOME/.cys/dept-catalog.json}" b
  if [ -f "$cat" ]; then
    b="$(python3 - "$cat" "$acct" <<'PY'
import json,sys,os
cat,acct=sys.argv[1:3]
try: d=json.load(open(cat))
except Exception: sys.exit(1)
a=d.get('accounts',{}).get(acct)
if not a: sys.exit(2)
print(os.path.expandvars(a))
PY
)" && [ -n "$b" ] && { echo "$b"; return 0; }
  fi
  [ -n "${HOME:-}" ] || return 1            # 규약 fallback도 불가 → fail-closed 신호
  echo "$HOME/.cys/claude-$acct"
}

# ── ★T11(P3-5 · R3-P03-5 4조건): Windows 한정 credentials 시드 ────────────────
# 부서 fork config dir 에 base 계정의 .credentials.json 사본을 1회 심어 부서마다 수동 /login 을
# 면제한다. 왜 Windows 한정인가(아래 create 의 2026-08-23 실측 정정 주석 참조): macOS 는 토큰이
# Keychain 에 계정 단위가 **아니라** config dir 경로 단위(서비스명 Claude Code-credentials-
# <sha256(dir)[:8]>)로 봉인돼 파일 복사로 브리지가 불가하다 — macOS 분기 자체를 만들지 않는다.
# Windows 는 토큰이 config dir 안의 .credentials.json 파일이라 복사가 성립한다.
# 4조건(계약 · R3-P03-5):
#   ① Windows 판별 = 기존 uname case 관례(dept_sock 동형) 재사용.
#   ② opt-in: CYS_DEPT_SEED_CREDS=1 일 때만(기본 off = 완전 무동작). 근거: OAuth refresh 토큰이
#      회전형(1회용)이면 N개 사본이 독립 갱신하다 상호 무효화(전 부서 동시 로그아웃)될 수 있다는
#      **실기 미검증 추정 리스크** — 실기 검증 게이트(Windows 2부서 24h 동시 가동·양쪽 토큰 생존
#      확인) 통과 전 기본 활성 금지(U-20 동류 계약).
#   ③ copy-if-absent 만: 대상 기존재=무동작 로그 1줄. 덮어쓰기 절대 금지 — rotate(=launch 재귀)가
#      fork 의 살아있는(이미 갱신된) 토큰을 base 의 낡은 사본으로 덮으면 그 레인 로그인이 파괴된다.
#   ④ 3 호출부(launch/allocate/create)의 fork dir mkdir 직후에만 · 원천=resolve_default_base/
#      카탈로그가 해석한 **그 계정의** base config dir 의 .credentials.json(~/.claude 하드코딩
#      금지 — 다계정 부서에 타 계정 토큰 주입 차단) · 사본은 소유자 전용 권한(umask 077+chmod 600 —
#      MSYS 가 Windows ACL 로 근사 매핑·best-effort). create 비primary 분기(공유 계정 dir·포크
#      없음)는 호출하지 않는다 — 살아있는 계정 자격증명 클로버 금지(원천=대상 동일 belt 겸비).
# 실패=전부 loud skip(fail-open — 부서 생성 불파괴·수동 /login 폴백 안내). stdout 오염 금지(전 진단 >&2).
# 잔존 고지: teardown(down/purge-state)은 계정 fork dir 를 지우지 않으므로 사본은 부서 폐기 후에도
# 디스크에 남는다(자동 삭제는 비가역이라 하지 않는다 — 오너 고지 사항).
seed_credentials_win(){
  local srcbase="$1" fork="$2"
  [ "${CYS_DEPT_SEED_CREDS:-0}" = "1" ] || return 0            # ② opt-in 기본 off — 완전 무동작
  case "$(uname -s 2>/dev/null)" in                            # ① Windows 한정(관례 재사용)
    MINGW*|MSYS*|CYGWIN*) ;;
    *) return 0 ;;
  esac
  [ -n "$fork" ] || return 0
  if [ -z "$srcbase" ]; then
    echo "[cys-dept] WARN: creds 시드 skip — base config dir 유도 실패. 부서 pane에서 수동 /login 필요" >&2
    return 0
  fi
  if [ "${srcbase%/}" = "${fork%/}" ]; then                    # ④ belt: 원천=대상(포크 아님) = 시드 금지
    echo "[cys-dept] creds 시드 skip: 원천=대상 동일($fork) — 포크 dir 아님(공유 계정 dir 클로버 금지)" >&2
    return 0
  fi
  local src="${srcbase%/}/.credentials.json" dst="${fork%/}/.credentials.json"
  if [ -e "$dst" ]; then                                       # ③ copy-if-absent — 기존재=무동작(멱등)
    echo "[cys-dept] creds 시드 무동작: $dst 기존재(덮어쓰기 금지 — rotate 갱신 토큰 보호)" >&2
    return 0
  fi
  if [ ! -f "$src" ]; then
    echo "[cys-dept] WARN: creds 시드 skip — 원천 부재($src). 부서 pane에서 수동 /login 필요" >&2
    return 0
  fi
  local tmp="$dst.tmp.$$"
  if ( umask 077 && cp "$src" "$tmp" ) 2>/dev/null \
     && { chmod 600 "$tmp" 2>/dev/null || true; } \
     && mv "$tmp" "$dst" 2>/dev/null; then
    echo "[cys-dept] creds 시드 완료: $src → $dst (사본·소유자 전용 권한 · opt-in CYS_DEPT_SEED_CREDS=1)" >&2
  else
    rm -f "$tmp" 2>/dev/null || true
    echo "[cys-dept] WARN: creds 시드 실패($src → $dst) — 부서 pane에서 수동 /login 필요(fail-open)" >&2
  fi
  return 0
}

# 데몬 소켓의 live(미exited) surface role 목록을 출력(줄당 1개·role 없으면 '-'). cys list 파싱(read-only).
# ★NO_AUTOSTART(identify autostart 감사 2026-07-10): 읽기 프로브가 죽은 소켓에서 cysd를 되살리지 않게.
dept_live_roles(){
  CYS_NO_AUTOSTART=1 CYS_SOCKET="$1" "$CYS" list 2>/dev/null | python3 - <<'PY'
import sys
for line in sys.stdin:
    f=line.rstrip("\n").split("\t")
    if len(f)<4: continue
    role=f[1][5:] if f[1].startswith("role=") else ""
    if f[3].endswith("true"): continue   # exited surface 무시
    print(role if role else "-")
PY
}
# 데몬에 live master surface가 있나? (더블master guard용)
# ★[6] pipefail+EPIPE 하드닝: dept_live_roles|grep -qx는 grep 조기종료 시 상류 python이 SIGPIPE→비0→
#   pipefail이 매치(0)를 비0(미발견)로 오판할 수 있다. 출력을 변수로 받아 here-string grep(파이프 제거).
dept_has_master(){
  local roles; roles="$(dept_live_roles "$1")" || true
  grep -qx "master" <<<"$roles"
}

# 소켓 생존 probe → cys ping(RC-6: unix 소켓·Windows named pipe 양쪽 OS중립·AF_UNIX 제거). exit 0=alive.
sock_alive(){ CYS_SOCKET="$1" "$CYS" ping >/dev/null 2>&1; }

# ★reaper 유휴 판정(read-only): stdout="IDLE" | "ACTIVE:<이유>".
#   유휴 = live(미exited) master surface 부재 AND (agent-backed·비-cso/리뷰어) live surface 부재.
#   ★[1] surface.list RPC로 surface별 agent(agent_meta name)까지 조회(cys list엔 agent 필드 없음) → 빈 zsh
#        placeholder(agent=None)는 활동으로 치지 않아 실제 누수(GUI 빈 첫 pane·각성전 데몬)를 회수, 실 에이전트 워커는 보호.
#   ★[5] grace: reserved_at(인자) 또는 소켓 mtime이 CYS_DEPT_REAP_GRACE(기본 60)초 이내면 mid-boot/사람
#        셸 보호로 ACTIVE 취급. probe 불가는 보수적 ACTIVE(오회수 방지).
dept_classify_idle(){ CYS_REAP_GRACE="${CYS_DEPT_REAP_GRACE:-60}" python3 - "$1" "${2:-0}" <<'PY'
import sys,os,json,time,subprocess
sk=sys.argv[1]; rat=float(sys.argv[2] or 0)
GRACE=float(os.environ.get("CYS_REAP_GRACE","60")); now=time.time()
recent=rat
try: recent=max(recent, os.stat(sk).st_mtime)   # named pipe(Windows)면 OSError→rat만 사용
except OSError: pass
if recent and now-recent < GRACE:
    print("ACTIVE:grace(%.0fs<%g)"%(now-recent,GRACE)); sys.exit(0)
# RC-6 잔여(T2.1·codex CONFIRMED): AF_UNIX surface.list → `cys status --json`(OS중립·named pipe 대응).
# result에 surfaces[{role,agent,exited}] 포함(handlers 2320·2324·2328·request가 result 언랩). 판정 로직 동일.
try:
    r=subprocess.run([os.environ.get("CYS_BIN","cys"),"status","--json"], env={**os.environ,"CYS_SOCKET":sk},
                     capture_output=True, timeout=5)
    if r.returncode!=0: raise RuntimeError("cys status rc=%d"%r.returncode)
    surfaces=(json.loads(r.stdout.decode("utf-8","replace")) or {}).get("surfaces",[])
except Exception:
    print("ACTIVE:probe-failed"); sys.exit(0)   # 조회 불가 → 보수적 비유휴(오회수 차단·정책 유지)
for s in surfaces:
    if s.get("exited"): continue
    role=s.get("role") or ""
    if role=="master":
        print("ACTIVE:master"); sys.exit(0)
    # agent-backed = surface에 에이전트가 배정됨(agent_meta name 존재). ★보수적: agent_alive(=seen) 대신
    # agent 존재를 쓴다 — 부팅 중(agent_meta 세팅·아직 미seen) 워커를 오회수하지 않기 위함([5] 안전우선).
    # 빈 zsh placeholder(agent=None)는 활동 아님 → 실제 누수 회수([1]). cso/리뷰어는 지원노드라 제외.
    if s.get("agent") is not None and role!="cso" and not role.startswith("reviewer"):
        print("ACTIVE:agent(%s/%s)"%(role or '-', s.get('agent'))); sys.exit(0)
print("IDLE")
PY
}

# ★WP-12: 기본 데몬(cys 기본 소켓) role=master 원본 세션에 현재 MASTER_DIRECTIVE.md 를 라이브 재주입.
#   파일 교체(MASTER↔CEO)만으로는 이미 실행 중인 원본 master 컨텍스트가 안 바뀐다(감사 에러②) →
#   승격/강등 직후 원본 master 1개(부서 소켓 아님)에 재주입해 라이브 반영한다. env -u CYS_SOCKET 로
#   상속된 부서 소켓을 지우고 cys 기본 소켓(원본 master)만 대상. agent 있는 실 master만 재주입하고
#   빈 셸(agent=None)·조회불가는 skip(빈 zsh 오해석 각성핑 차단 — WP-11 정합). best-effort(부서 lifecycle 불파괴).
ceo_reinject_master(){
  local why="${1:-directive}" has_agent
  has_agent=$(env -u CYS_SOCKET "$CYS" status --json 2>/dev/null | python3 -c '
import json,sys
try: d=json.load(sys.stdin)
except Exception: sys.exit(2)
for s in d.get("surfaces",[]):
    if s.get("role")=="master" and not s.get("exited"):
        print("yes" if s.get("agent") is not None else "no"); sys.exit(0)
sys.exit(3)' 2>/dev/null) || true
  if [ "$has_agent" = "yes" ]; then
    env -u CYS_SOCKET "$CYS" reinject --role master >/dev/null 2>&1 \
      && echo "[cys-dept] 원본 master 라이브 재주입($why) 완료" >&2 \
      || echo "[cys-dept] WARN: 원본 master 라이브 재주입($why) 미확정 — read-screen 점검" >&2
  else
    echo "[cys-dept] 원본 master 재주입($why) skip: 실 agent 없음(빈 셸)·조회불가 — 각성핑 미발사(WP-11 정합)" >&2
  fi
}
# CEO 승격: 부서가 1개 이상이면 기본 데몬을 CEO로(디렉티브 교체, 가역 백업). 부서 0이면 표준 master 보존(하위호환).
# ★자동 승격(제품 기본 정책): 부서(최소 1개 마스터) 생성 자체를 승격 동의로 간주해 자동 승격한다.
#   (종전 2026-07-14 'feed 승인/지명 필요'는 폐기 — GUI 승인 버튼이 §3.2 자기승인 차단·토큰 불일치로 침묵
#   실패해 승격이 걸리던 문제 해소). 지명(promote-ceo)은 여전히 오너 직접 경로다. 마커(.pre-ceo)=기승인 상태라 조정(무결 유지)은 묻지 않는다.
# ★부트 게이트(BOOTSTRAP_HARDENING WP-2): base master가 한 번도 부트되지 않은 기계
#   (.master-bootstrapped 부재 — writer=javis_bootstrap.py 성공 경로 유일)에서는 승격을 PENDING으로
#   보류한다. 부트 전 승격은 "부트 시퀀스 0개인 CEO"를 낳는다(윈도우 초보 실사고 근본원인 R2).
#   stale 정책(설계 §4.1): 이 게이트는 마커 '존재만' 본다(버전 무관 — 승격은 조직 사실).
BOOT_MARKER="$HOME/.cys/.master-bootstrapped"
CEO_PENDING="$HOME/.cys/state/ceo-pending"
# ★DCE-3(T10·오너 결정 ⑨): CEO_TEMPLATE ⊇ MASTER_DIRECTIVE 상위집합 런타임 검사 —
#   반쪽마스터 실사고(승격이 표준 디렉티브를 스텁으로 replace — 팩 업데이트로 수리가 되돌려져
#   라이브 FAIL) 재발의 **런타임 층** 방어. 빌드 층(gen_ceo_template --check)은 배포 회귀를 못
#   막는다(보증이 템플릿 빌드에만 있으면 배포본 드리프트 시 재발 — REPORT DCE-3).
#   판정 = ref(표준 MASTER 전문) 바이트열이 CEO 템플릿 안에 verbatim 포함되는가(합성 계약
#   gen_ceo_template: fragment + 구분선 + MASTER 바이트 무수정 연접 — 정상 템플릿은 항상 참).
#   ref 는 OR-포함(★MF-1 수정 라운드): ceo ⊇ md **또는** ceo ⊇ .pre-ceo 중 하나면 통과 —
#   종전 단일 결박(.pre-ceo 존재=무조건 .pre-ceo 기준)은 교차버전 실사고 형상(팩 업데이트가
#   md 를 새 표준 MASTER v2 로 갱신·.pre-ceo 엔 구 v1 잔존)에서 정상 v2 템플릿도 영구 보류시켜
#   반쪽마스터 수복 경로를 자기봉쇄했다. 스텁은 둘 다 미포함 = 차단 강도 불변.
#   비교는 개행(CRLF→LF) 정규화 후(★SF-2: Windows 체크아웃·에디터 변환 드리프트 false hold 방지).
#   실패(비포함·판독 불능·검사기 실행 실패)는 전부 보류(fail-closed — '측정 불능은 통과가 아니다').
ceo_template_superset_ok(){  # $1=CEO 템플릿 경로 $2=기준(표준 MASTER 전문) 경로 — 0=상위집합
  python3 - "$1" "$2" <<'PY'
import sys
ceo_p, ref_p = sys.argv[1], sys.argv[2]
try:
    with open(ceo_p, "rb") as f: ceo = f.read()
    with open(ref_p, "rb") as f: ref = f.read()
except OSError as e:
    sys.stderr.write("[cys-dept] superset 검사 판독 불능: %s\n" % e); sys.exit(2)
if not ref:
    sys.stderr.write("[cys-dept] superset 검사: 기준본이 비어 있음(%s)\n" % ref_p); sys.exit(2)
# ★SF-2: 개행 정규화(CRLF→LF) 후 포함 판정 — 개행은 표현 계층이라 인코딩 드리프트만으로
#   보류하지 않는다(문면 동일성 판정은 유지 — 실내용 결손·스텁은 여전히 비포함=1).
sys.exit(0 if ref.replace(b"\r\n", b"\n") in ceo.replace(b"\r\n", b"\n") else 1)
PY
}
ceo_promote(){  # $1: "consented"면 오너 지명(promote-ceo) 경로 — 자동 승격 알림 생략
  local md="$PACK_DEFAULT/directives/MASTER_DIRECTIVE.md"
  local ceo="$PACK_DEFAULT/directives/CEO_TEMPLATE.md"
  [ -f "$ceo" ] || { echo "[cys-dept] CEO 템플릿 없음 — 승격 생략(cys init-pack 필요)"; return 0; }
  cmp -s "$md" "$ceo" 2>/dev/null && { rm -f "$CEO_PENDING" 2>/dev/null || true; return 0; }
  if [ ! -f "$md.pre-ceo" ] && [ ! -f "$BOOT_MARKER" ]; then
    # PENDING: 부서 생성 자체는 성공 유지(return 0). 침묵 금지 — feed(비대기·보조)+stderr 고지,
    # GUI 상시 배지는 ceo-pending 파일 존재로 렌더(WP-2/T6). 해소=부트 ⑦ one-shot 또는 차기 lifecycle.
    mkdir -p "$(dirname "$CEO_PENDING")"
    printf 'pending since %s\n' "$(date +%Y-%m-%dT%H:%M:%S 2>/dev/null || echo unknown)" > "$CEO_PENDING"
    env -u CYS_SOCKET "$CYS" feed push --title "CEO 승격 보류(부트 필요)" \
      --body "부서가 생성되었으나 base master가 아직 부트되지 않았습니다. base에서 '너는 마스터다' 또는 '마스터 시작' 버튼으로 부트를 완료하면 명령 팔레트의 'CEO 승격 진행'으로 승인할 수 있습니다." >/dev/null 2>&1 || true
    echo "[cys-dept] CEO 승격 보류(PENDING) — base master 미부트(.master-bootstrapped 부재)" >&2
    return 0
  fi
  # ★자동 승격(제품 기본 정책): 종전 feed --wait 동의 게이트를 제거한다. 부서 생성 자체를 승격 동의로
  #   간주해 자동 승격한다(GUI 승인 버튼이 §3.2 자기승인 차단·토큰 불일치로 침묵 실패해 승격이 걸리던 문제 해소).
  #   위 ③ 부트 마커 PENDING 게이트는 불변(미부트 머신 승격 금지). consented(오너 지명)는 원래 자동 아님 — 알림 생략 판별용.
  local _auto=0
  if [ ! -f "$md.pre-ceo" ] && [ "${1:-}" != "consented" ]; then _auto=1; fi
  # ★동시 승격 직렬화(2026-07-15 적대검증 D-5): 두 promote가 겹치면 두 번째가 "pre-ceo 없음"을
  # 읽은 뒤 첫 번째의 cp(ceo→md) 이후 실행돼 CEO 템플릿을 .pre-ceo로 복사→ceo_demote 원복 불능.
  # flock으로 백업+교체를 원자화(flock 미설치 환경은 그대로 진행 — 인간 페이스 더블클릭은 저위험).
  # ★승격 영수증(G0 D3·스펙 D3(ii)): _swap이 cp 후 적용 템플릿의 sha256을 pack 트리 내
  #   directives/.ceo-template-applied 에 기록(내용=hex 해시 1줄) — preflight C03이 '영수증 해시
  #   등가 > 표지 3핀 폴백' 우선순위로 승격 표지를 결정론 판정한다. 위치를 ~/.cys/state가 아닌
  #   pack 트리에 두는 근거=Tier1 백업 원자성(.pre-ceo와 같은 축·복원 시 세대 불일치 방지).
  #   기록 실패는 승격 불차단(fail-open — 판정은 표지 핀 폴백). shasum=mac/win PortableGit 공통 가용.
  _swap(){
    # ★DCE-3(T10) 1단계 — 스왑 '직전' 상위집합 런타임 검사(락 안 = 검사·스왑 원자). 실패 rc 3
    #   = 스왑 미실행(md·.pre-ceo·영수증 전부 무접촉) — 보류 처리(PENDING 유지+loud)는 호출부.
    # ★MF-1(P3 수정 라운드): OR-포함 판정 — ceo ⊇ md 또는 ceo ⊇ .pre-ceo 중 하나면 통과.
    #   근거: 단일 ref 결박은 '팩 업데이트로 md=새 표준 v2·.pre-ceo=구 v1' 교차버전 형상에서
    #   정상 템플릿을 영구 보류시킨다(반쪽마스터 실사고의 기계 수복 재차단 — 리뷰어1 MF-1).
    #   스텁(반쪽마스터)은 md·.pre-ceo 어느 쪽도 포함하지 않아 차단 강도는 불변이다.
    # ★R3-CEO-2(2026-08-26 적대검증) — ref 집합에 **vendor 신본 `$md.new`** 를 추가한다.
    #   MF-1 이 상정한 구제 형상('팩 업데이트가 md 를 새 표준 v2 로 갱신')은 **실제 업데이트
    #   경로에서 발생할 수 없다**: `directives/*_DIRECTIVE.md` 는 pack.rs `ownership()` 상
    #   Ownership::User 라 디스크≠임베드이면 `Keep{new_pending}` 로 **영구 보존**되고(force
    #   여도) 신본은 `<rel>.new` 로만 병치된다(pack.rs decide_file_action). 그래서 이미 승격된
    #   기계의 업그레이드 후 형상은
    #     md=구 CEO 템플릿 사본(User·불가침) · .pre-ceo=승격 시점 구 표준 MASTER(백업·팩 대상
    #     아님) · ceo=신 CEO_TEMPLATE(**System 등급이라 강제 치유로 갱신됨**)
    #   이고 ceo⊇md·ceo⊇.pre-ceo 가 **둘 다 거짓**이다 — MASTER_DIRECTIVE 본문을 한 줄만
    #   고쳐도 전 기승격 함대가 rc 3 영구 보류 + `ceo-promote-pending-tick`(10분)의 무한
    #   재판정에 빠진다. `$md.new` 는 그 형상에서 유일하게 **현행 임베드 표준 MASTER 전문**을
    #   담고 있는 vendor 소유 파일이라 교차버전 형상의 정당한 ref 다.
    #   ★차단 강도 불변: 스텁 템플릿은 md·.new·.pre-ceo 어느 전문도 포함하지 않는다(3-ref
    #   전부 미포함 = 여전히 rc 3). `.pristine/directives/MASTER_DIRECTIVE.md` 는 ref 로 쓰지
    #   않는다 — 동결된 user-owned 파일의 pristine 은 갱신되지 않아(pack.rs: "동결 파일 조상은
    #   미갱신") 구 표준이 박혀 있어 구제력이 없다.
    #   잔존 both/three-fail 형상(md=구 CEO 문면 + 낡은 .pre-ceo + .new 부재)은 fail-closed
    #   보류가 옳다 — 해소 절차는 호출부 보류 메시지에 명시(stale .pre-ceo 갱신/제거).
    local _sup_ok=1
    ceo_template_superset_ok "$ceo" "$md" && _sup_ok=0
    if [ "$_sup_ok" -ne 0 ] && [ -f "$md.new" ]; then
      ceo_template_superset_ok "$ceo" "$md.new" && _sup_ok=0
    fi
    if [ "$_sup_ok" -ne 0 ] && [ -f "$md.pre-ceo" ]; then
      ceo_template_superset_ok "$ceo" "$md.pre-ceo" && _sup_ok=0
    fi
    [ "$_sup_ok" -eq 0 ] || return 3
    [ -f "$md.pre-ceo" ] || cp "$md" "$md.pre-ceo"; cp "$ceo" "$md"
    local h
    if h="$(shasum -a 256 "$md" 2>/dev/null)" && [ -n "$h" ]; then
      printf '%s\n' "${h%% *}" > "$PACK_DEFAULT/directives/.ceo-template-applied"
    else
      echo "[cys-dept] WARN: 승격 영수증 기록 실패(.ceo-template-applied) — C03은 표지 핀 폴백으로 판정" >&2
    fi
  }
  local _swap_rc=0
  if command -v flock >/dev/null 2>&1; then
    ( flock 9; _swap ) 9>"$md.promote.lock" || _swap_rc=$?
  else
    # ★A13(win): PortableGit엔 flock CLI가 없어 종전엔 무락(D-5 동시 승격 레이스 방어 부재) —
    #   mkdir 원자 락 폴백(원자적 mkdir 성공=락 획득). 획득 실패=경고 후 진행(현행 무락보다 강화·
    #   인간 페이스 더블클릭은 저위험이라 차단하지 않는다 — 잔존 락은 수동 rmdir 안내).
    if mkdir "$md.promote.lock.d" 2>/dev/null; then
      _swap || _swap_rc=$?
      rmdir "$md.promote.lock.d" 2>/dev/null || true
    else
      echo "[cys-dept] WARN: 승격 락($md.promote.lock.d) 획득 실패 — 동시 승격 의심, 무락 진행(잔존 락은 rmdir로 정리)" >&2
      _swap || _swap_rc=$?
    fi
  fi
  if [ "$_swap_rc" -ne 0 ]; then
    # ★DCE-3(T10): 스왑 미완 = **승격 보류** — PENDING 유지(부재면 기록 — GUI 상시 배지가 보류를
    #   렌더)+loud stderr. return 0 = lifecycle 불파괴(부트 마커 PENDING 게이트와 같은 비치명
    #   계약 — 지명 경로의 truthful 실패는 promote-ceo post-verify(D-2)가 md 미교체를 보고
    #   exit 5 로 담당). rc 3 = 상위집합 검사 실패(스왑 자체가 미실행 — md·.pre-ceo·영수증
    #   무접촉), 그 외 = 스왑 중 오류(종전엔 set -e 로 스크립트 전체 즉사하던 경로의 가청 강등).
    mkdir -p "$(dirname "$CEO_PENDING")"
    # ★SF-1(P3 수정 라운드): 계약 문면은 'PENDING **유지**'다 — 보류 시 신규 생성은 자동/대기형
    #   경로 한정. 오너 지명(consented·promote-ceo 1회성) 경로의 보류까지 PENDING 을 생성하면
    #   지명 실패가 상시 자동승격 예약(집행 틱이 템플릿 수리 후 무제스처 승격)으로 확폭된다.
    #   기존 PENDING 은 어느 경로든 유지(삭제 없음).
    if [ ! -f "$CEO_PENDING" ] && [ "${1:-}" != "consented" ]; then
      printf 'pending since %s (superset-hold)\n' \
        "$(date +%Y-%m-%dT%H:%M:%S 2>/dev/null || echo unknown)" > "$CEO_PENDING"
    fi
    if [ "$_swap_rc" -eq 3 ]; then
      echo "[cys-dept] ★CEO 승격 보류(DCE-3 상위집합 검사 실패) — CEO_TEMPLATE 이 표준 MASTER_DIRECTIVE 전문(md·.new·.pre-ceo 어느 쪽도)을 verbatim 포함하지 않는다(스텁/드리프트 의심 — 반쪽마스터 재발 차단). 해소: ①스텁이면 scripts/gen_ceo_template.py 재합성 또는 팩 갱신 ②md 가 이미 CEO 문면인데 .pre-ceo 가 낡았으면 .pre-ceo 를 현행 표준 MASTER 전문으로 갱신(또는 제거) 후 재시도 ③팩 업데이트 직후의 교차버전 형상(md=구 CEO 사본·.pre-ceo=구 표준)이면 vendor 신본 MASTER_DIRECTIVE.md.new 가 있어야 자동 통과한다 — .new 가 없으면 \`cys init-pack\` 으로 병치본을 재생성하라. PENDING 유지." >&2
      # 비대기 feed — 제목 완전일치 dedupe(A11 동형): 주기 집행 틱이 10분마다 재밀어도 적체 0.
      if ! env -u CYS_SOCKET "$CYS" feed list --status pending 2>/dev/null \
           | awk -F'\t' '$4=="CEO 승격 보류(템플릿 상위집합 검사 실패)"{found=1} END{exit !found}'; then
        env -u CYS_SOCKET "$CYS" feed push --title "CEO 승격 보류(템플릿 상위집합 검사 실패)" \
          --body "CEO_TEMPLATE.md 가 표준 MASTER_DIRECTIVE.md 전문(현행 md·vendor 신본 .new·백업 .pre-ceo 어느 쪽도)을 포함하지 않아 승격을 보류했습니다(스텁 교체 = 반쪽마스터 재발 경로 차단). 해소: ①스텁이면 팩 갱신 또는 gen_ceo_template.py 재합성 ②.pre-ceo 만 낡은 형상이면 .pre-ceo 를 현행 표준 전문으로 갱신 후 재시도 ③팩 업데이트 직후의 교차버전 형상(이미 CEO 로 승격된 기계는 MASTER_DIRECTIVE.md 가 user 소유라 갱신되지 않고 신본이 .new 로만 병치됩니다)이면 그 .new 실재를 확인하십시오 — 없으면 cys init-pack 으로 재생성. 승격 대기(PENDING)는 유지됩니다." >/dev/null 2>&1 || true
      fi
    else
      echo "[cys-dept] WARN: CEO 승격 스왑 미완(rc=$_swap_rc) — 승격 보류·PENDING 유지. 디스크/권한 점검 후 재시도." >&2
    fi
    return 0
  fi
  rm -f "$CEO_PENDING" 2>/dev/null || true   # 승격 완료 = PENDING 해소
  echo "[cys-dept] 기본 데몬 CEO 승격(directives 교체·백업 .pre-ceo)"
  ceo_reinject_master "CEO 승격"
  if [ "$_auto" -eq 1 ]; then
    # ★자동 승격 직후 비대기 알림(제품 기본 정책). 승격 차단 금지(fail-open).
    #   ★리뷰어1 F4: 종전 `|| true`는 push 실패(데몬 미기동 등)를 삼켜 오너가 정체성 변경을 통지받지 못했다 →
    #   실패 시 stderr 1줄 가시화(exit code 무오염 — || 리스트 마지막이 echo라 set -e 안전).
    #   가역 사실 근거: ceo_demote는 부서 0개(reg_count=0) 시 down/down-sock에서 자동 호출되어 .pre-ceo
    #   백업을 복원한다(수동 강등 명령은 없음 — 환각 금지).
    env -u CYS_SOCKET "$CYS" feed push --title "CEO 승격 완료(자동)" \
      --body "부서 생성 감지 — 제품 기본 정책에 따라 기본 데몬 master를 CEO로 자동 승격했습니다. 가역: 부서를 모두 정리해 0개가 되면 자동으로 표준 master로 강등(원복)됩니다(.pre-ceo 백업 복원)." >/dev/null 2>&1 \
      || echo "[cys-dept] 승격 완료 알림 push 실패(데몬 미기동?) — 승격 자체는 완료됨" >&2
  fi
}
ceo_demote(){
  local md="$PACK_DEFAULT/directives/MASTER_DIRECTIVE.md"
  local ceo="$PACK_DEFAULT/directives/CEO_TEMPLATE.md"
  local receipt="$PACK_DEFAULT/directives/.ceo-template-applied"
  rm -f "$CEO_PENDING" 2>/dev/null || true   # 부서 0 = 승격 사유 소멸 — PENDING 청소(승격 이력 무관)
  if [ ! -f "$md.pre-ceo" ]; then
    # ★무음 no-op 승격(스펙 A6/E2): 승격 표지(md==CEO 템플릿 또는 영수증 실재)가 있는데 복원 백업이
    #   없으면 '강등 불능(비가역 상태)'다 — 종전 무음 return 0은 이 상태를 영구 잠복시켰다. stderr
    #   경보+feed push(비대기)로 가시화하되 return 0 유지(teardown 체인 불파괴 — 부트 비치명 계약).
    #   미승격 머신(표지 없음)의 .pre-ceo 부재는 정상 no-op — 경보 없음(위경보 소음 금지).
    #   영수증은 여기서 삭제하지 않는다(비가역 상태의 판정 증거 보존 — C03 소관).
    if cmp -s "$md" "$ceo" 2>/dev/null || [ -f "$receipt" ]; then
      echo "[cys-dept] WARN: CEO 강등 불능 — 복원 백업(.pre-ceo) 부재(비가역 상태). preflight C03 안내(.pristine 재건/pack-merge)로 MASTER_DIRECTIVE.md 복원 필요" >&2
      env -u CYS_SOCKET "$CYS" feed push --title "CEO 강등 불능(.pre-ceo 부재)" \
        --body "부서 0개 도달로 CEO 강등을 시도했으나 복원 백업(MASTER_DIRECTIVE.md.pre-ceo)이 없어 표준 master로 원복하지 못했습니다. preflight C03 안내에 따라 .pristine 재건 또는 pack-merge로 MASTER_DIRECTIVE.md를 복원하십시오." >/dev/null 2>&1 \
        || echo "[cys-dept] WARN: 강등 불능 알림 push 실패(데몬 미기동?) — 위 stderr 경보가 유일 흔적" >&2
    fi
    return 0
  fi
  cp "$md.pre-ceo" "$md"; rm -f "$md.pre-ceo"
  rm -f "$receipt" 2>/dev/null || true   # ★승격 영수증 삭제(G0 D3) — 강등=승격 사실 소멸(stale 영수증 방지)
  echo "[cys-dept] CEO 강등(표준 master 원복)"
  ceo_reinject_master "표준 master 복귀"
}

# ── ★결함#1: 부서 생성 = CEO 티켓 자동 발급 (오너 절대규칙) ────────────────────────
# ★결함(실측): 이 도구 전체에 `issue-ticket` 호출이 **0건**이었다 — GUI(또는 CLI)로 만든 부서는
#   티켓이 없어 부서장이 '단독 각성'(solo_awakening)으로 팀 없이 대기했다(javis_bootstrap.py
#   ③″ CEO 티켓 권한 게이트 = 티켓 부재 시 팀 기동 생략·exit 0).
# ★대조: base 레인 폴백 경로("2번째 마스터 선언 → 부서 자동 창설")에는 티켓 자동 발급이 이미
#   있다(javis_bootstrap.py D3 — `_ticket_path`·`_peek_dept_ticket` 와 동일 스키마·경로).
#   즉 **같은 오너 규칙이 한쪽 경로에만 배선**돼 있었다.
# ★오너 절대규칙: 부서를 만들고 선언하면 팀이 기동돼야 한다. 오너의 부서 생성 행위 자체가 발급
#   동의다(D3 "오너 타이핑 선언=발급 동의"와 동일 규약).
#
# 티켓 저장소 — javis_bootstrap.py `TICKET_DIR`(STATE_DIR/dept-boot-tickets) 규약 미러.
# STATE_DIR = CYS_STATE_DIR ‖ $HOME/.cys/state (bootstrap `state_dir()` 와 동일 우선순위).
# ★미러인 근거: 이 파일은 이미 소켓 경로(dept_sock↔_dept_sk/_sk_named)를 같은 방식으로 미러한다.
TICKET_DIR="${CYS_STATE_DIR:-$HOME/.cys/state}/dept-boot-tickets"

# 유효 티켓 존재 여부(멱등 판정 · **소비하지 않는다**). exit 0=유효(발급 생략) / 비0=발급 진행.
# javis_bootstrap.py `_parse_ticket_json` 계약 미러: JSON 객체 · dept 일치 · issued_at(epoch 숫자)
# · 0<=경과<=TTL(CYS_DEPT_TICKET_TTL_SECS ‖ 24h).
# ★판정 불가(python3 부재·파싱 실패·읽기 실패)는 전부 비0 = **발급 쪽으로 보수적**이다 —
#   오판의 대가가 비대칭이기 때문이다(과발급=TTL 리셋뿐, 미발급=팀 0인 부서 방치).
dept_ticket_valid(){
  python3 - "$TICKET_DIR/$1.ticket" "$1" <<'PY' >/dev/null 2>&1
import json,os,sys,time
p,dept=sys.argv[1:3]
TTL=float(os.environ.get("CYS_DEPT_TICKET_TTL_SECS", 24*3600))
try:
    d=json.load(open(p,encoding="utf-8"))
except Exception:
    sys.exit(1)                                   # 부재·손상 → 발급
if not isinstance(d,dict) or d.get("dept")!=dept: sys.exit(1)
ts=d.get("issued_at")
if not isinstance(ts,(int,float)) or isinstance(ts,bool): sys.exit(1)
age=time.time()-ts
sys.exit(0 if 0<=age<=TTL else 1)                 # 미래(시계 이상)·만료 → 발급
PY
}

# CEO 티켓 자동 발급 — 부서 생성 경로(launch/create/allocate)가 **ceo_promote 이후**에 호출한다
# (CEO가 존재해야 발급이 의미를 갖는다).
# ★base 레인 전용: `issue-ticket` 은 부서 소켓이면 exit 2로 거부한다("base 레인에서만 티켓 발급
#   허용") → 상속된 CYS_SOCKET 을 반드시 지운다(이 파일의 tombstone·feed push 관례와 동일).
# ★fail-open(필수): 발급 실패(스크립트 부재·python3 없음·비정상 exit·부서명 정규식 불일치)가
#   **부서 생성을 무너뜨리면 안 된다** — 항상 return 0 이고 teardown trap 은 건드리지 않는다.
#   실패 시 stderr 경고 1줄 + 수동 발급 안내만 남기고 진행한다.
# ★소비 금지: 티켓은 24h TTL·1회성이며 소비(.used rename)는 **부서장 부트**가 한다
#   (javis_bootstrap.py ④ boot 성공 직후 `_consume_dept_ticket` — "1회성 티켓 ⟺ 실스폰" 불변식).
# $2(선택): 이번 호출에서 데몬을 **실제로 스폰했는가** — 1=신규 스폰 · 0=이미 가동 중이라 재사용.
#   ★적대검증 ⑦(의도적 설계 · 되돌리지 마라): 재사용 경로(`이미 가동 중 — 재사용`)에서도 발급한다.
#   javis_bootstrap.py 의 "1회성 티켓 ⟺ 실스폰" 불변식은 **소비 측**(부트가 ④ cys boot 성공 직후에만
#   태운다) 계약이고, 여기 발급 측까지 확장하면 오너 절대규칙이 깨진다: 데몬만 살아 있고 팀은 없는
#   부서(부서장 세션 재시작·/clear·이전 단독 각성)가 **영구히 팀 0으로 고착**된다 — rotate 를 막지
#   않기로 한 것과 정확히 같은 논리다. 재사용 발급의 대가는 "24h 창 안의 부서장 부트 1회가 팀 스폰
#   권한을 얻는다"인데, 그 부트 주체는 오너가 띄운 그 부서의 부서장이므로 오너 동의 범위 안이다.
#   대신 **침묵하지 않는다** — 재사용 경로 발급은 로그 문면으로 구분한다(아래 spawned=0 분기).
dept_issue_ceo_ticket(){
  local name="$1" spawned="${2:-1}" bs="$PACK_DEFAULT/bin/javis_bootstrap.py" out why
  local manual="수동 발급: base(본부) 레인에서 \`python3 \"$bs\" issue-ticket --dept $name\`"
  if [ ! -f "$bs" ]; then
    echo "[cys-dept] WARN: $name CEO 티켓 자동 발급 생략 — $bs 부재(팩 미설치·스큐). 부서장이 '단독 각성'(팀 0)으로 뜬다. $manual" >&2
    return 0
  fi
  if dept_ticket_valid "$name"; then
    echo "[cys-dept] $name 유효 CEO 티켓 기존재 — 재발급 생략(멱등·TTL 리셋 방지)" >&2
    return 0
  fi
  if out="$(env -u CYS_SOCKET python3 "$bs" issue-ticket --dept "$name" 2>&1)"; then
    if [ "$spawned" = "1" ]; then
      echo "[cys-dept] $name CEO 티켓 발급 완료 — 부서장이 뜨면 팀(cso·워커·리뷰어)이 자동 기동된다(24h TTL·1회성·소비는 부서장 부트)" >&2
    else
      # ★적대검증 ⑦ 가시화: 신규 스폰이 없었는데 발급했다는 사실을 문면에 드러낸다(위 함수 주석의 근거).
      echo "[cys-dept] $name CEO 티켓 발급 완료 ★데몬 재사용 경로(신규 스폰 없음) — 팀 0 고착 방지를 위한 의도적 발급이다. 24h 창 안의 부서장 부트 1회가 팀을 기동한다(1회성·소비는 부서장 부트)" >&2
    fi
  else
    # 사유는 1줄로 접어 붙인다(다줄 stderr가 로그를 흩지 않게). 대표 사유: python3 부재 ·
    # base 레인 판정 실패 · 부서명이 발급 규약 불일치.
    # ★스테일 정정(2026-08-22 검증리뷰): 종전 이 주석은 구 정규식 `[a-z0-9][a-z0-9-]*`(kebab-case
    #   전용)을 인용했는데, 정규식은 생성기와 `[A-Za-z0-9][A-Za-z0-9_-]{0,39}` 로 **단일화**됐다 —
    #   대문자·'_' 는 이제 정상 통과다. 거짓 안내라 실제 규약으로 고친다(실 사유 문면은 발급기
    #   stderr 를 그대로 접어 싣는 $why 가 전달하므로 여기 하드코딩된 집합은 두지 않는다).
    why="$(printf '%s' "$out" | tr '\n' ' ' | cut -c1-240)"
    echo "[cys-dept] WARN: $name CEO 티켓 자동 발급 실패 — 부서 생성은 정상, 다만 부서장이 '단독 각성'(팀 0)으로 뜬다. $manual (사유: ${why:-불명})" >&2
  fi
  return 0
}

cmd="${1:?usage: cys-dept launch|allocate|create|down|down-sock|rotate|reap|promote-ceo|promote-if-pending [--request-only]|list|sock <name> | <name> -- <cmd>}"
# ★D3(i): cmd 위치 --help/-h만 usage(stdout·exit 0) — 읽기 전용이라 단일소유 가드(exit 7)보다 앞·역할
#   무관. ★name 위치의 --help/-h는 usage가 아니라 검증 거부 exit 2다(`launch --help`가 '--help' 부서를
#   등재→껍데기 CEO 승격까지 간 실사고의 재발 차단 — 가드(exit 7)는 name 검증보다는 선행 유지).
case "$cmd" in --help|-h) usage; exit 0 ;; esac
# ★단일소유 기술 강제(CEO 2026-06-22): 부서 lifecycle mutation은 CSO(CYS_ROLE=cso)·GUI(role 없음·오너
# 직접)만 허용한다. roled 비-CSO 노드(부서장 master·워커·리뷰어·CEO)의 cys-dept create/down 직접 호출을
# 차단해 다중주체 churn(빈 dept-N·중복·레이스)을 기술적으로 방지. (defense-in-depth — 의도적 unset 우회는
# 거버넌스 영역이나, 정상 다중 노드 churn은 차단). 읽기 전용(list/sock/<name> --)은 무제한.
case "$cmd" in
  launch|allocate|create|down|down-sock|rotate|reap|promote-ceo)
    if [ -n "${CYS_ROLE:-}" ] && [ "${CYS_ROLE}" != "cso" ]; then
      echo "[cys-dept] ★단일소유 강제: 부서 lifecycle mutation은 CSO/GUI 전용(CYS_ROLE=$CYS_ROLE 차단·다중 churn 방지). CSO에 요청하라." >&2
      exit 7
    fi ;;
  promote-if-pending)
    # --request-only는 무변조(조건 확인+알림 재발행뿐)라 가드 면제 — 부트 스크립트 ⑦(master 세션)이
    # 호출한다. 대기형(실제 승격)은 여타 mutation과 동일하게 CSO/GUI 전용.
    if [ "${2:-}" != "--request-only" ] && [ -n "${CYS_ROLE:-}" ] && [ "${CYS_ROLE}" != "cso" ]; then
      echo "[cys-dept] ★단일소유 강제: promote-if-pending(대기형)은 CSO/GUI 전용 — master 세션은 --request-only만 허용." >&2
      exit 7
    fi ;;
esac
case "$cmd" in
  launch)
    name="${2:-}"
    # ★D3(i): name 확보 직후·일체 부작용(dept_sock 산출·mkdir·reg_upsert) 이전 검증 — 빈/미지정 포함
    #   전부 exit 2. CYS_DEPT_ROTATE=1(rotate 재귀)에도 검증 유지(rotate 진입부 사전 검증과 이중 방어).
    #   slug 충돌도 부작용 이전 조기 거부(reg_upsert 진입부 검사와 공통 헬퍼 — 기존명 재-launch는 자기
    #   제외로 통과).
    validate_dept_name "$name" "launch <name>"
    reject_slug_collision "$name"
    sock="$(dept_sock "$name")"; pack="$(dept_pack "$name")"
    mkdir -p "$(dept_logdir "$name")" "$pack/directives"
    seed_acl "$pack"
    reg_upsert "$name" "$sock" "$pack"
    # ★G3(W3): 계정격리 복원 — rotate 가 이 경로를 재귀 호출하므로, 여기서 계정 dir 을 유도하지
    #   않으면 **재기동 한 번으로 격리가 조용히 풀린다**(데몬 env 소실 → 자식 claude 가 오너 base
    #   config 를 공유). 유도값 없음 = 계정격리 미사용 부서(구 launch 산출) → 무동작(회귀 0).
    acctdir="$(resolve_lane_acctdir "$name" "$pack" | tail -1)"
    if [ -n "$acctdir" ]; then
      mkdir -p "$acctdir" 2>/dev/null || true
      [ -d "$acctdir" ] || { echo "[cys-dept] ERROR: $name account dir 사용 불가($acctdir) — fail-closed(비격리 기동 금지)" >&2; exit 5; }
      # ★T11(P3-5): fork dir 확정 직후 creds 시드(Windows·opt-in·copy-if-absent — 함수 계약 참조).
      #   기본 off 시 유도 자체를 생략(launch=rotate 핫패스에 python spawn 0). 원천은 등재 account
      #   (create 산출·카탈로그 키)를 우선, 없으면 기본계정 키를 resolve_default_base 로 해석한 그
      #   계정의 base — 다계정 경계 보존(~/.claude 하드코딩 금지). rotate 재귀에서도 대상 기존재
      #   무동작(③)이 갱신 토큰을 지킨다.
      if [ "${CYS_DEPT_SEED_CREDS:-0}" = "1" ]; then
        _credacct="$(reg_get_field "$name" account 2>/dev/null | tail -1)"
        [ -n "$_credacct" ] || _credacct="${CYS_DEPT_DEFAULT_ACCOUNT:-default}"
        _credbase="$(resolve_default_base "$_credacct" 2>/dev/null)" || _credbase=""
        seed_credentials_win "$_credbase" "$acctdir"
      fi
    fi
    _spawned=1   # ★⑦: 이번 호출에서 데몬을 실제로 스폰했는가(0=재사용) — 티켓 발급 로그 문면 구분용
    if ready "$sock"; then
      echo "[cys-dept] $name 이미 가동 중 — 재사용"
      _spawned=0
    else
      if [ -n "$acctdir" ]; then
        CYS_SOCKET="$sock" CYS_PACK_DIR="$pack" CYS_ACCOUNT_DIR="$acctdir" \
          nohup "$CYSD" >"$(dept_logdir "$name")/cysd.log" 2>&1 &
      else
        CYS_SOCKET="$sock" CYS_PACK_DIR="$pack" nohup "$CYSD" >"$(dept_logdir "$name")/cysd.log" 2>&1 &
      fi
      disown
      # 기동 실패 시 reg_upsert 롤백 — 유령 부서(데몬 없는 레지스트리 항목) 잔류 방지
      ready "$sock" || { reg_remove "$name"; echo "[cys-dept] ERROR: $name 데몬 기동 실패"; exit 1; }
    fi
    seed_schedule "$pack"   # owner-progress-report 제거(부서는 최상위 보고 안 함) — 데몬 30초 핫리로드로 반영
    # ★G3: 시드 검증(+자기치유) — 데몬 env 전파에 의존하지 않는 belt(구 cysd·재기동 경로 대비).
    #   실패는 '비격리 확정'이므로 fail-closed 로 멈춘다(create/allocate 의 exit 6 규약과 동형).
    if ! verify_lane_account_seed "$pack" "$acctdir"; then
      echo "[cys-dept] ERROR: $name 계정격리 시드 실패(agents.json CLAUDE_CONFIG_DIR≠$acctdir) — fail-closed" >&2
      exit 6
    fi
    ceo_promote
    # ★결함#1: CEO 승격 이후 티켓 자동 발급(fail-open — 실패해도 부서 생성은 성공).
    #   rotate(=이 경로 재귀)도 통과시킨다: rotate 는 데몬을 새로 띄우므로 팀(cso·워커·리뷰어
    #   surface)이 함께 사라진다 — 여기서 막으면 rotate 한 번에 '팀 0인 부서'가 영구 고착된다.
    #   유효 티켓이 남아 있으면 멱등 판정이 재발급을 막으므로 TTL 리셋도 없다(묘비 불변 계약 무관).
    #   ★⑦: 재사용 분기(_spawned=0)에서도 발급한다 — 근거는 dept_issue_ceo_ticket 함수 주석.
    dept_issue_ceo_ticket "$name" "$_spawned"
    dept_tombstone_remove "$name"   # WP-3·R6ⓒ: 재기동 성공 = 재생성 의도 확정 → 묘비 해소(rotate는 내부 가드로 no-op)
    formation_ensure_async "$name" "$sock"   # ★T9(P3-1 ⓐ): 상비편성 — 생성 직후 배선(fail-open)
    echo "[cys-dept] $name 가동 완료 (sock=$sock pack=$pack acct=${acctdir:-none}). 부서 수=$(reg_count)"
    ;;
  allocate)
    # 번호계산+예약을 단일 flock 블록에 묶어 TOCTOU 제거 — lowest-unused dept-N을 발급·예약(원자).
    # 시나리오2: 레지스트리엔 빠졌어도 소켓을 점유 중인(죽어가는) 데몬 번호는 alive() probe로 skip.
    name=$(reg_init; python3 - "$REG" <<'PY'
import json,sys,os,re,socket as S
try:
    import fcntl
    def _lk(f): fcntl.flock(f, fcntl.LOCK_EX)
    def _ulk(f): fcntl.flock(f, fcntl.LOCK_UN)
except ImportError:  # RC-6 Windows: fcntl 부재 → msvcrt 바이트락(파일 닫힘 시 해제·_ulk no-op 안전)
    import msvcrt
    def _lk(f):
        try: msvcrt.locking(f.fileno(), msvcrt.LK_LOCK, 1)
        except OSError: pass
    def _ulk(f): pass
p=sys.argv[1]
lf=open(p+'.lock','w'); _lk(lf)
try:
    try: d=json.load(open(p))
    except Exception: d={'depts':{}}
    depts=d.setdefault('depts',{})
    home=os.path.expanduser('~')
    # ★[2] hard cap(reserve flock 안 — 동시성·원자성 유지): 죽은(미reap) 등록은 빼고 ★살아있는 데몬만 카운트.
    # RC-6: AF_UNIX→cys ping(OS중립·named pipe 대응). os.path.exists는 named pipe에 False라 제거.
    import subprocess
    def _alive_sk(sk):
        if not sk: return False
        try: return subprocess.run([os.environ.get("CYS_BIN","cys"),"ping"], env={**os.environ,"CYS_SOCKET":sk},
                                   capture_output=True, timeout=3).returncode==0
        except Exception: return False
    CAP=int(os.environ.get("CYS_DEPT_CAP","8"))
    live=sum(1 for e in depts.values() if _alive_sk(e.get('socket','')))
    if live>=CAP:
        sys.stderr.write("[cys-dept] allocate 거부: live 부서 수 %d ≥ CYS_DEPT_CAP=%d (hard cap·죽은등록 제외)\n"%(live,CAP)); sys.exit(8)
    used={int(m.group(1)) for k in depts if (m:=re.match(r'^dept-(\d+)$',k))}
    def _dept_sk(n):  # RC-6: OS별 부서 소켓(dept_sock 규약 미러) — Windows named pipe·unix .sock
        return (r"\\.\pipe\cys-dept-dept-%d"%n) if os.name=="nt" else f"{home}/.local/state/cys-dept-dept-{n}/cys.sock"
    def alive(n):  # 시나리오2: 레지스트리엔 빠졌어도 소켓 점유(죽어가는 데몬)면 그 번호 재사용 금지
        return _alive_sk(_dept_sk(n))
    N=1
    while N in used or alive(N): N+=1
    name=f"dept-{N}"
    depts[name]={'socket':_dept_sk(N),  # RC-6: OS별 소켓 규약(Windows named pipe·unix .sock)
                 'pack_dir':f"{home}/.cys/pack-dept-{name}",'role':'dept-master'}
    tmp=p+'.tmp.%d'%os.getpid()
    with open(tmp,'w') as f: json.dump(d,f,ensure_ascii=False,indent=2); f.flush(); os.fsync(f.fileno())
    os.replace(tmp,p)
    print(name)
finally: _ulk(lf)
PY
) || exit $?   # ★cap 거부(exit 8)·예약 실패 코드 그대로 전파
    [ -n "$name" ] || { echo "[cys-dept] allocate: 번호 발급 실패" >&2; exit 1; }
    trap 'reg_remove "$name" 2>/dev/null || true' EXIT   # 예약 후 비정상종료=예약 회수(SIGKILL 제외)
    # ★D3(i) 사후 assert: allocate name은 기계 생성(dept-N)이라 항상 정형이 정상 — 불변식 위반·
    #   slug 충돌(레거시 'DEPT-N' 등재 등)은 여기서 거부(exit 2·위 trap이 예약 회수). A2 공통 헬퍼.
    validate_dept_name "$name" "allocate"
    reject_slug_collision "$name"
    sock="$(dept_sock "$name")"; pack="$(dept_pack "$name")"
    # ★계정격리(Fix1'): 기본계정 base 해석 → 부서별 fork dir(<base>-<name>). base 해석불가=fail-closed.
    # 기본계정은 CYS_DEPT_DEFAULT_ACCOUNT로 명시 지정한다(공개 배포본에 특정 오너 핸들을 박지 않는다 —
    # 운영자가 한 번 설정: export CYS_DEPT_DEFAULT_ACCOUNT=<account>).
    # 기본계정 미지정 시 fail-close 대신 일반 네임스페이스 'default'로 폴백 → +부서 버튼이 즉시 동작한다.
    # 부서는 여전히 <base>-<name>(각 부서 고유 dir)로 개별 격리되고, 'default'는 특정 오너 핸들이 아니므로
    # "공개 배포본에 오너 핸들 미주입" 설계 취지도 유지된다. 명시 격리는 export CYS_DEPT_DEFAULT_ACCOUNT=<account>(우선).
    acct="${CYS_DEPT_DEFAULT_ACCOUNT:-default}"
    base="$(resolve_default_base "$acct")" || { echo "[cys-dept] allocate: 기본계정 base 해석 불가($acct) — fail-closed" >&2; exit 5; }
    [ -n "$base" ] || { echo "[cys-dept] allocate: 기본계정 base 빈값($acct) — fail-closed" >&2; exit 5; }
    acctdir="${base%/}-$name"; mkdir -p "$acctdir"
    [ -d "$acctdir" ] || { echo "[cys-dept] allocate: account fork dir 생성 실패: $acctdir — fail-closed" >&2; exit 5; }
    # ★T11(P3-5): fork dir mkdir 직후 creds 시드(Windows·opt-in·copy-if-absent — 함수 계약 참조).
    #   원천은 위에서 해석된 바로 그 계정의 base(resolve_default_base 산출 — 다계정 경계 보존).
    seed_credentials_win "$base" "$acctdir"
    # ★G3(W3): account_dir 을 레지스트리에 **기록**한다 — rotate/launch 가 계정격리를 복원할 때
    #   읽는 SOT 다(create 는 예약 시점에 이미 기록한다). 종전엔 allocate 산출 부서에 이 값이 없어
    #   유도 3순위(agents.json 잔존 시드)만이 유일한 흔적이었다.
    reg_set_field "$name" account_dir "$acctdir" || true
    mkdir -p "$(dept_logdir "$name")" "$pack/directives"
    seed_acl "$pack"
    _spawned=1   # ★⑦: 신규 스폰 여부(0=재사용) — 티켓 발급 로그 문면 구분용
    if ready "$sock"; then echo "[cys-dept] $name 이미 가동 중 — 재사용" >&2; _spawned=0
    else
      # ★계정 격리: 데몬을 CYS_ACCOUNT_DIR(fork dir)와 함께 spawn (create와 동형).
      CYS_SOCKET="$sock" CYS_PACK_DIR="$pack" CYS_ACCOUNT_DIR="$acctdir" nohup "$CYSD" >"$(dept_logdir "$name")/cysd.log" 2>&1 &
      disown
      ready "$sock" || { reg_remove "$name"; echo "[cys-dept] ERROR: $name 데몬 기동 실패" >&2; exit 1; }
    fi
    # ★데몬 up 확정 후 실패 trap을 풀teardown(kill+소켓+reg)으로 업그레이드 — 이후 단계 set -e 종료 시 orphan 0.
    trap '"$0" down "$name" >/dev/null 2>&1 || true' EXIT
    seed_schedule "$pack"
    ceo_promote 1>&2   # ceo_promote의 승격 메시지를 stderr로 — allocate stdout은 name만(파서 오염 차단)
    # ★Fix1' 계정격리: agents.json CLAUDE_CONFIG_DIR 을 fork dir로 치환(F1). 실패=비격리 → fail-closed teardown.
    if ! seed_agents_account "$pack" "$acctdir"; then
      echo "[cys-dept] ERROR: $name agents.json 계정시드 실패 — fail-closed: 부트 중단·teardown" >&2
      "$0" down "$name" >/dev/null 2>&1 || true; trap - EXIT; exit 6
    fi
    trap - EXIT   # 격리 확정 — 회수 취소
    # ★결함#1: CEO 승격·계정격리 확정 이후 티켓 자동 발급(fail-open). 빈 셸 생성 **이전**에 둔다 —
    #   오너가 그 셸에서 즉시 claude 를 띄워 선언해도 티켓이 이미 있어야 팀이 기동된다.
    #   trap 해제 이후 지점이라 발급 실패가 teardown 을 유발할 여지도 없다(fail-open 이중 보증).
    #   ★⑦: 재사용 분기(_spawned=0)에서도 발급 — 근거는 dept_issue_ceo_ticket 함수 주석.
    dept_issue_ceo_ticket "$name" "$_spawned"
    # ★제품 기본 정책(2026-06-29 결정): 부서 생성 시 claude 자동연결 폐지 → role=master '빈 셸'만 띄운다.
    #   사용자가 그 터미널에서 직접 claude 를 실행해 부서장으로 연결한다(Decision A '부서장 자동각성'을
    #   allocate 경로에서 폐지). UI 자동입양은 role 있는 surface 만 받으므로(main.ts:1268 !s.role 가드)
    #   --role master 필수·--cmd 생략=기본 로그인 셸. CYS_DEPT_NO_MASTER=1=셸도 생략(빈 데몬). 이미 master면 멱등.
    #   ★후행 결정 갱신(T9·오너 ②a 상비편성(B) — 규범 이중화 방지): 위 '빈 셸만' 문면은 **이 지점의
    #   즉시 동작**(여기서 직접 각성시키지 않는다)으로 한정된다. 부서 생성의 최종 상태는 상비편성이며,
    #   실제 팀 완결은 성공 꼬리의 formation_ensure_async(→javis_formation ensure — 빈 셸 입양 포함)가
    #   담당한다. 즉 '자동 각성 폐지'는 이 인라인 경로의 폐지이지 편성 완결의 폐지가 아니다.
    if [ "${CYS_DEPT_NO_MASTER:-0}" = 1 ]; then
      echo "[cys-dept] $name CYS_DEPT_NO_MASTER=1 — 셸 미생성(빈 데몬)" >&2
    elif dept_has_master "$sock"; then
      echo "[cys-dept] $name 이미 master surface 존재 — 셸 생성 생략(멱등)" >&2
    elif CYS_SOCKET="$sock" "$CYS" new-surface --socket "$sock" --role master --cwd "${CYS_DEPT_CWD:-$HOME}" >/dev/null 2>&1; then
      echo "[cys-dept] $name role=master 빈 셸 생성 완료 — 사용자가 직접 claude 연결 (cwd=${CYS_DEPT_CWD:-$HOME})" >&2
    else
      echo "[cys-dept] WARN: $name 셸 생성 실패 — read-screen 점검(데몬·격리는 정상)" >&2
    fi
    dept_tombstone_remove "$name"   # WP-3·R6ⓒ: 번호 재사용으로 묘비명과 충돌 시 보호 재편입
    formation_ensure_async "$name" "$sock"   # ★T9(P3-1 ⓐ): 상비편성 — 생성 직후 배선(fail-open)
    echo "[cys-dept] $name allocate 완료 (sock=$sock acct=$acctdir)" >&2
    echo "$name"   # ★stdout 마지막 줄 = 확정 name (Tauri 파싱). 진단은 전부 >&2
    ;;
  create)
    # ＋부서 자동화: 카탈로그 기반 완전 자동 부서 생성(부서명·계정·미션·각성). 레거시 allocate 무변경.
    key="${2:-}"
    # ★D3(i): 카탈로그 key도 동일 화이트리스트 — acctdir('-$key' 접미)·미션 경로($MISS/$key.md) 합성
    #   인자다. 카탈로그 존재 검사(exit 3)보다 앞(부적격 key는 카탈로그 유무와 무관하게 exit 2).
    validate_dept_name "$key" "create <catalog-key>"
    CAT="${CYS_DEPT_CATALOG:-$HOME/.cys/dept-catalog.json}"
    MISS="${CYS_DEPT_MISSIONS:-$HOME/.cys/dept-missions}"
    [ -f "$CAT" ] || { echo "[cys-dept] 카탈로그 부재: $CAT (GUI=레거시 allocate fallback)" >&2; exit 3; }  # fail-closed
    # 카탈로그 조회 + account dir 해석($HOME 전개). 파싱실패/키부재=fail-closed.
    IFS=$'\t' read -r disp acctkey acctdir mkey cwd < <(python3 - "$CAT" "$key" <<'PY'
import json,sys,os
cat,key=sys.argv[1:3]
d=json.load(open(cat))                                   # 파싱실패=예외=비0=fail-closed
dep=d['departments'].get(key)
if not dep: sys.exit(4)
acct=dep['account']; acctdir=os.path.expandvars(d['accounts'][acct])
# 탭 구분(codex 비차단 하드닝): display/cwd 에 공백 있어도 필드 안 깨짐(공백필드 취약성 제거)
print('\t'.join([dep['display'], acct, acctdir, dep['mission_key'], os.path.expandvars(dep['cwd'])]))
PY
) || { echo "[cys-dept] 카탈로그 키 미정의/손상: $key" >&2; exit 4; }
    # 부서별 config dir 분리(제품 기본 절차): primary(공유) 계정→부서별 dir(~/.cys/claude-<key>)로 config state 경합 완화.
    # primary 계정 키는 env CYS_PRIMARY_ACCOUNT로 외부화(기본 'owner')·오너는 자기 primary 핸들 값으로 설정하면 동일 동작 유지.
    # ★정정(2026-08-23 실측 · 종전 서술 "Max 계정 토큰은 macOS Keychain(계정단위)으로 공유 유지·dir만 분리" 는 반증됨):
    #   macOS Keychain 항목은 계정 단위가 아니라 **config dir 경로 단위**다 —
    #   서비스명 `Claude Code-credentials-<sha256(CLAUDE_CONFIG_DIR 절대경로)[:8]>`.
    #   측정: `security dump-keychain` 서비스명 9개 열거 → 경로 sha256 앞 8자리와 7개 정확 일치
    #   (`~/.claude`=bdf68cc2 · `~/.cys/claude`=c45eaec5 · `~/.cys/claude-default-dept-1`=55f9f695).
    #   ∴ dir 를 분리하는 이 줄의 동작(`-<key>` 접미)은 **토큰 공유를 깨뜨린다** — 새로 만든 부서 dir 는
    #   macOS 에서 자체 `/login` 1회가 필요하다(복사·이동으로 브리지 불가). Windows 는 토큰이 config dir 안의
    #   `.credentials.json` 파일이라 복사가 성립한다. 단독 계정(부서 1개)은 이미 단독이라 불변.
    if [ "$acctkey" = "${CYS_PRIMARY_ACCOUNT:-owner}" ]; then
      _credbase="$acctdir"   # ★T11: 포크 前 값 = 카탈로그 accounts[acct] 해석 base(그 계정 경계 유지)
      acctdir="${acctdir%/}-$key"; mkdir -p "$acctdir"
      # ★T11(P3-5): 포크 분기에서만 시드(Windows·opt-in·copy-if-absent — 함수 계약 참조).
      #   비primary 분기(공유 계정 dir·포크 없음)는 시드 금지 — 살아있는 계정 자격증명 클로버 방지.
      seed_credentials_win "$_credbase" "$acctdir"
    fi
    [ -d "$acctdir" ] || { echo "[cys-dept] account dir 미존재(계정누수 차단): $acctdir" >&2; exit 5; }  # fail-closed
    # F3(codex): 멱등검사+예약을 단일 flock 원자. ★같은 mission_key 엔트리=청구됨 → REUSE(데몬 생사 무관·
    #   호출부가 ensure-ready). 신규는 lowest-unused 예약 + ★엔트리에 mission_key 기록(동시/부팅중 다른
    #   create가 즉시 발견 — codex: NEW 엔트리에 mission_key 누락 TOCTOU 해소).
    res=$(reg_init; CYS_GRACE="${CYS_DEPT_RESERVE_GRACE:-25}" python3 - "$REG" "$mkey" "$cwd" "$acctdir" <<'PY'
import json,sys,os,re,time,socket as S
try:
    import fcntl
    def _lk(f): fcntl.flock(f, fcntl.LOCK_EX)
    def _ulk(f): fcntl.flock(f, fcntl.LOCK_UN)
except ImportError:  # RC-6 Windows: fcntl 부재 → msvcrt 바이트락(파일 닫힘 시 해제·_ulk no-op 안전)
    import msvcrt
    def _lk(f):
        try: msvcrt.locking(f.fileno(), msvcrt.LK_LOCK, 1)
        except OSError: pass
    def _ulk(f): pass
p,mkey,cwd,acctdir=sys.argv[1:5]
home=os.path.expanduser('~'); GRACE=float(os.environ.get("CYS_GRACE","25"))
import subprocess
def _sk_named(nm):  # RC-6: OS별 부서 소켓(bash dept_sock 규약 미러) — Windows named pipe·unix .sock
    return (r"\\.\pipe\cys-dept-%s"%nm) if os.name=="nt" else f"{home}/.local/state/cys-dept-{nm}/cys.sock"
def alive_sock(sk):  # RC-6: AF_UNIX→cys ping(named pipe 대응·os.path.exists는 pipe에 False라 제거)
    if not sk: return False
    try: return subprocess.run([os.environ.get("CYS_BIN","cys"),"ping"], env={**os.environ,"CYS_SOCKET":sk},
                               capture_output=True, timeout=3).returncode==0
    except Exception: return False
lf=open(p+'.lock','w'); _lk(lf)
try:
    try: d=json.load(open(p))
    except Exception: d={'depts':{}}
    depts=d.setdefault('depts',{}); now=time.time()
    # 멱등(원자): 같은 mission_key 엔트리=청구됨 → REUSE. 死活+reserved_at grace로 3분기(CSO 봉인):
    #   UP=서빙중 즉시반환 / BOOTING=생성자 부팅중(grace내)→신뢰·반환(boot tail 안 함=더블각성·더블미션 봉인)
    #   DEAD=grace 경과·미생존→호출부 ensure-up revive. (grace 없으면 부팅중을 死로 오판→ensure-up 더블부트)
    for n,e in depts.items():
        if e.get('mission_key')!=mkey: continue
        if alive_sock(e.get('socket','')): print("REUSE_UP "+n); sys.exit(0)
        if now-float(e.get('reserved_at',0))<GRACE: print("REUSE_BOOTING "+n); sys.exit(0)
        # ★R3.1(CSO·codex R3-REUSE-DEAD-CONCURRENT-REVIVE+META-STALE): 반환 전 같은 flock에서
        #   reserved_at=now 재청구 + cwd/account_dir 최신 catalog로 갱신 → 동시 follower=REUSE_BOOTING(더블부트 봉인)·메타 최신.
        e['reserved_at']=now; e['cwd']=cwd; e['account_dir']=acctdir
        tmp=p+'.tmp.%d'%os.getpid()
        with open(tmp,'w') as f: json.dump(d,f,ensure_ascii=False,indent=2); f.flush(); os.fsync(f.fileno())
        os.replace(tmp,p)
        print("REUSE_DEAD "+n); sys.exit(0)
    # ★[2] hard cap(NEW 분기만·reserve flock 안 — 동시성·원자성 유지): REUSE는 면제, 죽은(미reap) 등록은
    #   빼고 ★살아있는 데몬만 카운트(상단 alive_sock 재사용) — 신규 예약 전 live 수 ≥ cap 거부(exit 8).
    CAP=int(os.environ.get("CYS_DEPT_CAP","8"))
    live=sum(1 for e in depts.values() if alive_sock(e.get('socket','')))
    if live>=CAP:
        sys.stderr.write("[cys-dept] create NEW 거부: live 부서 수 %d ≥ CYS_DEPT_CAP=%d (hard cap·죽은등록 제외)\n"%(live,CAP)); sys.exit(8)
    # 신규 예약(lowest-unused·소켓 점유 번호 skip) — mission_key+reserved_at+메타 즉시 원자기록
    used={int(m.group(1)) for k in depts if (m:=re.match(r'^dept-(\d+)$',k))}
    N=1
    while N in used or alive_sock(_sk_named("dept-%d"%N)): N+=1
    name=f"dept-{N}"
    depts[name]={'socket':_sk_named(name),
                 'pack_dir':f"{home}/.cys/pack-dept-{name}",'role':'dept-master',
                 'mission_key':mkey,'cwd':cwd,'account_dir':acctdir,'reserved_at':now}
    tmp=p+'.tmp.%d'%os.getpid()
    with open(tmp,'w') as f: json.dump(d,f,ensure_ascii=False,indent=2); f.flush(); os.fsync(f.fileno())
    os.replace(tmp,p)
    print("NEW "+name)
finally: _ulk(lf)
PY
) || exit $?   # ★cap 거부(exit 8) 등 예약 실패 코드 그대로 전파
    verb="${res%% *}"; name="${res#* }"
    [ -n "$name" ] || { echo "[cys-dept] create: 예약 실패" >&2; exit 1; }
    # ★D3(i) 3분기 공통 관문(NEW/REUSE_UP·BOOTING/REUSE_DEAD): 예약 산출 name 검증 — 이 지점(verb/name
    #   분해 직후·case 이전)이 3분기를 전부 덮는 유일한 단일 삽입점이다. NEW는 기계 생성(dept-N)이라
    #   항상 통과 — 불합격=REUSE_*의 기존 등재가 비정형인 경우: '비정형 등재'로 stderr 보고만 하고
    #   exit 2(★자동 삭제 금지 — 정리는 정리 동사(down/down-sock)·D1(b) 수동 격리 소관).
    if ! dept_name_ok "$name"; then
      echo "[cys-dept] create: 비정형 등재 발견('$name' — mission_key 매칭 기존 엔트리) — 자동 삭제 금지·down-sock/D1(b) 정리 후 재시도" >&2
      exit 2
    fi
    sock="$(dept_sock "$name")"; pack="$(dept_pack "$name")"
    # 멱등 3분기 봉인(CSO): UP/BOOTING=즉시반환(boot tail 안 함=더블각성·더블미션 봉인)·DEAD=ensure-up revive·NEW=신규.
    case "$verb" in
      REUSE_UP)      echo "[cys-dept] $key 이미 생존($name) — 재사용" >&2; echo "$name"; exit 0 ;;
      REUSE_BOOTING) echo "[cys-dept] $key 생성자 부팅중($name) — 신뢰·재사용(중복부트 차단)" >&2; echo "$name"; exit 0 ;;
      REUSE_DEAD)    echo "[cys-dept] $key 등록부 잔존($name)·데몬 사망(grace 경과) → ensure-up 재기동" >&2 ;;
      NEW)           : ;;
      *)             echo "[cys-dept] create: 미지 verb '$verb'" >&2; exit 1 ;;
    esac
    # ── ensure-up: 데몬 기동 + 시드 + 격리 + 부서장 (NEW · REUSE-사망 공통) ──
    if [ "$verb" = "NEW" ]; then trap 'reg_remove "$name" 2>/dev/null || true' EXIT; fi  # NEW만 실패 시 예약회수(REUSE는 기존 보존)
    mkdir -p "$(dept_logdir "$name")" "$pack/directives"
    seed_acl "$pack"
    _spawned=1   # ★⑦: 신규 스폰 여부(0=재사용·REUSE_DEAD 재기동 포함) — 티켓 발급 로그 문면 구분용
    if ready "$sock"; then echo "[cys-dept] $name 이미 가동 — 재사용" >&2; _spawned=0
    else
      # ★계정 격리: 데몬을 CYS_ACCOUNT_DIR 와 함께 spawn(patch2 있으면 자식 전파·없으면 F1 시드가 보장)
      CYS_SOCKET="$sock" CYS_PACK_DIR="$pack" CYS_ACCOUNT_DIR="$acctdir" nohup "$CYSD" >"$(dept_logdir "$name")/cysd.log" 2>&1 &
      disown
      ready "$sock" || { if [ "$verb" = "NEW" ]; then reg_remove "$name"; fi; echo "[cys-dept] ERROR: $name 데몬 기동 실패" >&2; exit 1; }
    fi
    # ★R3.1(CSO·codex R3-REG-SET-META-ORPHAN): 데몬 up 확정 후 실패 trap을 풀teardown(down=kill+소켓+reg)으로 업그레이드.
    #   이후 reg_set_meta fail-closed/시드/각성에서 set -e 종료해도 이미 뜬 데몬 orphan 0. NEW·REUSE_DEAD 공통.
    trap '"$0" down "$name" >/dev/null 2>&1 || true' EXIT
    seed_schedule "$pack"
    ceo_promote 1>&2
    reg_set_meta "$name" "$disp" "$acctkey"   # display_name/account merge(mission_key는 예약시 원자기록·socket/role 보존)
    # F1(codex#1) ★fail-closed: agents.json 계정시드 실패 시 부트 안 함·teardown(비격리 부서장 금지·fail-open 차단).
    if ! seed_agents_account "$pack" "$acctdir"; then
      echo "[cys-dept] ERROR: $name agents.json 계정시드 실패 — fail-closed: 부트 중단·teardown" >&2
      "$0" down "$name" >/dev/null 2>&1 || true
      exit 6
    fi
    trap - EXIT   # 격리 확정 — 이후 빈 셸 생성
    # ★결함#1: allocate 와 동형 — CEO 승격·계정격리 확정 후, 빈 셸 생성 이전에 티켓 자동 발급(fail-open).
    #   REUSE_UP/REUSE_BOOTING 은 위에서 이미 exit 0 으로 빠졌다(신규 생성 아님 — 기존 부서 재사용).
    #   ★⑦: 여기 도달하는 REUSE_DEAD·기가동 재사용(_spawned=0)에서도 발급 — 근거는 함수 주석.
    dept_issue_ceo_ticket "$name" "$_spawned"
    # ★WP-11(2026-06-29 결정 일원화): create도 allocate와 동일하게 role=master '빈 셸'만 띄운다.
    #   자동 각성(부트 노드)+미션 자동주입(send --to master)을 폐지 — 사용자가 그 셸에서 직접 claude 를
    #   실행해 부서장으로 연결하고, 부서장이 미션 파일($MISS/$key.md)을 스스로 읽는다. 빈 셸(agent=None)엔
    #   phoenix 각성핑도 미발사(stage_reinject agent-gate) → 빈 zsh 오해석 에러 0. 계정격리·미션파일은 보존.
    #   ★후행 결정 갱신(T9·오너 ②a 상비편성(B) — 규범 이중화 방지): '빈 셸만'은 이 인라인 지점의 즉시
    #   동작 한정이다 — 최종 상태는 상비편성이고 팀 완결은 성공 꼬리의 formation_ensure_async 소관이다.
    # ★더블master guard(부트↔수동선언 경합 좀비 방지): 이미 live master surface가 있으면 셸 생성 생략(멱등).
    if dept_has_master "$sock"; then
      echo "[cys-dept] $name 이미 live master surface 존재 — 셸 생성 생략(멱등 더블master 방지)" >&2
    elif CYS_SOCKET="$sock" "$CYS" new-surface --socket "$sock" --role master --cwd "$cwd" >/dev/null 2>&1; then
      echo "[cys-dept] $name role=master 빈 셸 생성 완료 — 사용자가 직접 claude 연결 (미션 파일: $MISS/$key.md)" >&2
    else
      echo "[cys-dept] WARN: $name 셸 생성 실패 — read-screen 점검(데몬·격리는 정상)" >&2
    fi
    dept_tombstone_remove "$name"   # WP-3·R6ⓒ: 삭제→동명 재생성 시 보호 재편입
    formation_ensure_async "$name" "$sock"   # ★T9(P3-1 ⓐ): 상비편성 — 생성 직후 배선(fail-open)
    echo "[cys-dept] create '$disp'($name) 완료 (account=$acctkey sock=$sock)" >&2
    echo "$name"   # stdout 마지막 = 확정 name(Tauri 파싱)
    ;;
  down)
    # ★기능2 인자 파싱 하드닝: 플래그를 위치 무관 파싱하고 미지 플래그는 usage exit한다. 종전
    # `name="${2:?}"; $3 무시`는 오순서(`down --purge-state dept-3`)에서 "--purge-state"를 부서명으로
    # 흡수해 유령 부서를 down하는 무음 사고가 났다. 2인자 plain 호출(down <name>)은 거동 불변.
    name=""; purge_state=0
    shift  # "down" 제거
    for _a in "$@"; do
      case "$_a" in
        --purge-state) purge_state=1 ;;
        --*) echo "[cys-dept] down: 미지 플래그 '"'"'$_a'"'"' (usage: cys-dept down <name> [--purge-state])" >&2; exit 2 ;;
        *) if [ -z "$name" ]; then name="$_a"; else echo "[cys-dept] down: 인자 과다 '"'"'$_a'"'"' (usage: cys-dept down <name> [--purge-state])" >&2; exit 2; fi ;;
      esac
    done
    [ -n "$name" ] || { echo "usage: cys-dept down <name> [--purge-state]" >&2; exit 2; }
    sock="$(dept_sock "$name")"
    # ★NO_AUTOSTART(감사 2026-07-10): 죽은 부서 down 시 identify가 cysd를 되살려 그걸 kill하던 낭비 spawn 제거
    # — 실패 시 pid 빈값이면 아래가 kill을 건너뛰고 rm+reg_remove로 진행(종국 상태 동일).
    pid=$(CYS_NO_AUTOSTART=1 CYS_SOCKET="$sock" "$CYS" identify 2>/dev/null | python3 -c "import json,sys;print(json.load(sys.stdin).get('daemon_pid',''))" 2>/dev/null || true)
    # orphan 방지(오너 ③): kill 후 데몬 사망 확인·잔존 시 SIGKILL(down이 데몬 살린 채 reg_remove→orphan 재발 차단).
    if [ -n "${pid:-}" ]; then
      graceful_kill "$pid"
    fi
    rm -f "$sock" "$sock.lock" 2>/dev/null || true
    # ★R7(적대검증 W1): 묘비를 reg_remove **앞**에 — set -e 하에서 reg_remove 비0 종료
    # (disk-full·권한)가 묘비를 스킵하면 '등재+미묘비' 부활 창. 의도-선기록 순서(GUI 제1행위)와
    # 통일. dept_tombstone은 항상 0 반환(:49-58)이라 set -e 안전.
    dept_tombstone "$name"
    # ★G3 축1(결함2 치유층): 공용/개인 settings 의 이 부서 훅 잔존 정리 — 죽은 경로 훅은 매 Claude
    # 세션 "No such file" 실패 벡터다. best-effort(dept_tombstone 규약과 동형 — 실패가 teardown 을
    # 깨지 않는다 · 구 바이너리엔 없는 서브커맨드라 실패 허용). 제거 엔진은 hooks-prune 단일.
    env -u CYS_SOCKET "$CYS" hooks-prune --pack-dir "$(dept_pack "$name")" >/dev/null 2>&1 \
      || echo "[cys-dept] WARN: $name 훅 잔존 정리 미확정(hooks-prune 실패/구 바이너리) — cys doctor 로 확인" >&2
    reg_remove "$name"
    [ "$(reg_count)" = "0" ] && ceo_demote || true
    # ★기능2: --purge-state면 기본 teardown 체인 뒤 state 디렉토리(transcripts.db) 격리(mv→trash).
    # 묘비는 영구 존치(위 dept_tombstone) — purge는 재발견 경로(state dir)를 끊어 부활을 봉인한다.
    if [ "$purge_state" = 1 ]; then
      dept_purge_state "$name" || { echo "[cys-dept] $name state 격리 실패(위 사유·teardown은 완료)" >&2; exit 3; }
    fi
    echo "[cys-dept] $name 종료·정리 완료. 부서 수=$(reg_count)"
    ;;
  down-sock)
    # socket 기준 teardown — ws rename으로 name↔socket이 끊겨도 정확히 종료(레지스트리 역인덱스).
    sock="${2:?usage: cys-dept down-sock <socket>}"
    name=$(reg_init; python3 - "$REG" "$sock" <<'PY'
import json,sys
p,s=sys.argv[1:3]
d=json.load(open(p)).get('depts',{})
for n,e in d.items():
    if e.get('socket')==s: print(n); break
PY
)
    if [ -z "$name" ]; then
      # ★D8 봉쇄(BOOTSTRAP_HARDENING WP-3): 역인덱스 실패(rename 레이스·레지스트리 손상) 시
      # 소켓 슬러그(cys-dept-<name>[.sock 부모] · unix/named pipe 공통)에서 name을 파생 —
      # 종전엔 reg_remove·dept_tombstone이 통째로 스킵돼 '등재+미묘비' 부활 구멍이 남았다.
      # 파생 실패(비표준 소켓)면 종전과 동일(skip — 보수적).
      name=$(printf '%s' "$sock" | tr '\\' '/' | grep -o 'cys-dept-[^/]*' | head -1 | sed 's/^cys-dept-//') || true
      [ -n "$name" ] && echo "[cys-dept] down-sock: 역인덱스 실패 — 소켓 슬러그에서 name 파생($name)" >&2
    fi
    pid=$(CYS_NO_AUTOSTART=1 CYS_SOCKET="$sock" "$CYS" identify 2>/dev/null | python3 -c "import json,sys;print(json.load(sys.stdin).get('daemon_pid',''))" 2>/dev/null || true)
    if [ -n "${pid:-}" ]; then
      graceful_kill "$pid"
    fi
    rm -f "$sock" "$sock.lock" 2>/dev/null || true
    # ★R7: 묘비 선기록(순서 통일 — down verb·GUI 제1행위와 동일 축)
    [ -n "$name" ] && dept_tombstone "$name" || true
    # ★G3 축1: down verb 와 동일한 훅 잔존 정리(best-effort — teardown 불파괴 규약 동형).
    if [ -n "$name" ]; then
      env -u CYS_SOCKET "$CYS" hooks-prune --pack-dir "$(dept_pack "$name")" >/dev/null 2>&1 \
        || echo "[cys-dept] WARN: $name 훅 잔존 정리 미확정(hooks-prune 실패/구 바이너리) — cys doctor 로 확인" >&2
    fi
    [ -n "$name" ] && reg_remove "$name" || true
    [ "$(reg_count)" = "0" ] && ceo_demote || true
    echo "[cys-dept] socket teardown 완료(name=${name:-미등록}). 부서 수=$(reg_count)"
    ;;
  rotate)
    # ★버전 스큐 세대교체(재기동, ★폐기 아님): 데몬 프로세스만 정지→새 on-disk cysd로 재기동한다.
    # down(reg_remove+dept_tombstone+ceo_demote=의도적 폐기)과 달리 레지스트리·묘비·CEO를 절대 건드리지
    # 않는다 — CSO 단일소유 부서 생성/폐기 권한 불침범(rotate=순수 재기동). launch 로직을 재귀 재사용해
    # reg_upsert(merge·메타보존)+새 바이너리 spawn+seed+ceo_promote를 재확립한다.
    name="${2:?usage: cys-dept rotate <name>}"
    sock="$(dept_sock "$name")"
    # ★필수2(A·리뷰) 사전 게이트: 미등재(down됨/없음) 부서는 즉시 중단(exit 8·부활 금지). ping/identify(autostart
    # 부작용) 이전에 레지스트리(SOT)부터 확인해 side-effect 0으로 빠르게 거부한다. reg_names(SOT) 재사용.
    if ! reg_names | grep -Fxq -- "$name"; then
      echo "[cys-dept] $name 미등재(down됨) — rotate 중단(부활 금지)" >&2
      exit 8
    fi
    # ★D3(i) 사전 검증(등재 게이트 직후·kill 이전): rotate 꼬리=생성 동사 launch 재귀라, 비정형 등재명은
    #   kill 후 launch 검증 거부 = 데몬 죽고 등재만 남는 반파괴 half-op이 된다 — kill 없이 여기서 exit 2.
    #   grep `--`는 인자 위생(D3(i) — '-' 선두 등재명 옵션 오파싱 봉합, L974 재확인 게이트 동일).
    validate_dept_name "$name" "rotate <name>" "비정형 등재 — kill 미수행(데몬 불변). 정리는 cys-dept down-sock <sock> 또는 D1(b) 수동 격리로."
    # ★필수4(B·리뷰): rotate 대상 데몬이 실제 살아있는지 ping으로 먼저 확인(autostart 없는 연결 프로브).
    # ★함정: `cys identify`는 죽은 소켓에서 cysd를 autostart하는 부작용이 있어(스모크 실증) pid가 항상 채워져
    # "미확인" 판정을 못 한다 → ping(연결만·autostart 없음)으로 게이트한다. 미응답=소유자 사망 미확인이므로
    # 중단(exit 9): 이 상태에서 kill·rm·launch로 가면 유령 중복/오kill 위험. detectSkew가 방금 daemon_status
    # 성공한 부서만 넘기므로 이 실패는 일시적 — 다음 tick 재시도가 옳다(되살리기·중복 금지).
    if ! CYS_SOCKET="$sock" "$CYS" ping >/dev/null 2>&1; then
      echo "[cys-dept] $name 데몬 미응답(ping 실패) — rotate 중단(소유자 사망 미확인·유령 중복 방지)" >&2
      exit 9
    fi
    # 살아있음이 확인됐으니 identify는 실 데몬에 연결(autostart 없음). 구 버전(검증 게이트)·pid(kill 대상) 취득.
    oldver="$(CYS_NO_AUTOSTART=1 CYS_SOCKET="$sock" "$CYS" identify 2>/dev/null | python3 -c "import json,sys;print(json.load(sys.stdin).get('version',''))" 2>/dev/null || true)"
    pid=$(CYS_NO_AUTOSTART=1 CYS_SOCKET="$sock" "$CYS" identify 2>/dev/null | python3 -c "import json,sys;print(json.load(sys.stdin).get('daemon_pid',''))" 2>/dev/null || true)
    # 방어적 재확인(ping↔identify 사이 경합으로 pid 비면 중단 — 위와 동일 근거).
    if [ -z "${pid:-}" ]; then
      echo "[cys-dept] $name pid 미확인 — rotate 중단(소유자 사망 미확인·유령 중복 방지)" >&2
      exit 9
    fi
    # 프로세스만 종료(down의 graceful_kill 재사용 — OS중립·Windows taskkill 분기 포함, 신설 분기 없음).
    # graceful_kill이 사망을 동기 확인하므로 아래 launch의 ready 프로브가 죽은 소켓을 새것으로 오인하지 않는다.
    graceful_kill "$pid"
    rm -f "$sock" "$sock.lock" 2>/dev/null || true
    # ★필수2(A·리뷰) TOCTOU 재확인: kill·rm 도중 CSO down(reg_remove+dept_tombstone)이 레이스로 끼어들어
    # 폐기됐으면 launch(부활) 금지 — 사전 게이트 이후 창을 최소화하려 launch 직전에 한 번 더 확인(미등재→exit 8).
    if ! reg_names | grep -Fxq -- "$name"; then
      echo "[cys-dept] $name 미등재(down됨·rotate 중 폐기) — rotate 중단(부활 금지)" >&2
      exit 8
    fi
    # launch 재귀 호출: 소켓이 죽었으니 새 바이너리로 재spawn. CYS_ROLE 그대로 상속(게이트 통과 주체 동일).
    # launch stdout은 로그로 흘리고, 아래서 새 버전을 확정 출력한다.
    # CYS_DEPT_ROTATE=1: launch의 dept_tombstone_remove를 no-op으로 — rotate=묘비 불변 계약(WP-3).
    CYS_DEPT_ROTATE=1 bash "$0" launch "$name" || { echo "[cys-dept] ERROR: $name rotate 재기동 실패" >&2; exit 1; }
    newver="$(CYS_NO_AUTOSTART=1 CYS_SOCKET="$sock" "$CYS" identify 2>/dev/null | python3 -c "import json,sys;print(json.load(sys.stdin).get('version',''))" 2>/dev/null || true)"
    # ★검증 게이트(지시3): Rust/UI 성공 판정·사람 로그 확인용 — 마지막 줄에 확정 출력.
    echo "rotated $name: v${oldver:-?}→v${newver:-?}"
    ;;
  reap)
    # idle reaper: depts.json 순회 — ①소켓 死 등록 reg_remove ②유휴(live master 부재 AND agent-backed
    # 비-cso/리뷰어 live surface 부재 · grace 경과) 데몬 down-sock teardown. 판정=read-only(socket probe·
    # surface.list RPC). Phase1=flock 직렬화 레지스트리 스냅샷, Phase2=집행(flock 밖, ★kill 직전 원자 재검증).
    # --dry: 판정만(무변경). grace=CYS_DEPT_REAP_GRACE(기본 60s). 실집행: reg_remove/down-sock(각자 자체 flock).
    dry=0; [ "${2:-}" = "--dry" ] && dry=1
    reg_init
    # Phase 1 — flock 직렬화 스냅샷: 레지스트리(name·socket·reserved_at) 일관 덤프(read-only·짧은 락).
    snap=$(python3 - "$REG" <<'PY'
import json,sys
try:
    import fcntl
    def _lk(f): fcntl.flock(f, fcntl.LOCK_EX)
    def _ulk(f): fcntl.flock(f, fcntl.LOCK_UN)
except ImportError:  # RC-6 Windows: fcntl 부재 → msvcrt 바이트락(파일 닫힘 시 해제·_ulk no-op 안전)
    import msvcrt
    def _lk(f):
        try: msvcrt.locking(f.fileno(), msvcrt.LK_LOCK, 1)
        except OSError: pass
    def _ulk(f): pass
p=sys.argv[1]
lf=open(p+'.lock','w'); _lk(lf)
try:
    try: d=json.load(open(p))
    except Exception: d={'depts':{}}
    for n,e in d.get('depts',{}).items():
        print("%s\t%s\t%s"%(n, e.get('socket',''), e.get('reserved_at',0) or 0))
finally: _ulk(lf)
PY
) || { echo "[cys-dept] reap: 스냅샷 실패" >&2; exit 1; }
    # 분류+집행(flock 밖·probe). reg_remove/down-sock는 각자 자체 flock·원자. 현재 셸 루프(카운터 보존).
    nd=0; ni=0; ns=0
    while IFS=$'\t' read -r nm sk rat; do
      [ -n "$nm" ] || continue
      if ! sock_alive "$sk"; then
        nd=$((nd+1))
        if [ "$dry" = 1 ]; then echo "[cys-dept] reap(dry): DEAD $nm (sock 死) → reg_remove"
        else echo "[cys-dept] reap: DEAD $nm → reg_remove"; reg_remove "$nm"; fi
        continue
      fi
      cls="$(dept_classify_idle "$sk" "$rat")"
      if [ "$cls" != "IDLE" ]; then ns=$((ns+1)); echo "[cys-dept] reap: SKIP $nm (활동: $cls)" >&2; continue; fi
      if [ "$dry" = 1 ]; then ni=$((ni+1)); echo "[cys-dept] reap(dry): IDLE $nm → down-sock teardown"; continue; fi
      # ★[5] TOCTOU 차단: kill(down-sock) 직전 원자 재검증 — 스냅샷 이후 master/agent가 붙었으면 회수 취소.
      recls="ACTIVE:gone"; sock_alive "$sk" && recls="$(dept_classify_idle "$sk" "$rat")"
      if [ "$recls" = "IDLE" ]; then
        ni=$((ni+1)); echo "[cys-dept] reap: IDLE $nm → down-sock teardown"; "$0" down-sock "$sk" >/dev/null 2>&1 || true
      else
        ns=$((ns+1)); echo "[cys-dept] reap: SKIP $nm — 집행직전 재검증서 활동전환($recls), teardown 취소(TOCTOU 보호)" >&2
      fi
    done <<EOF
$snap
EOF
    # ★기능2 trash 만료 소거: N일(기본 14·CYS_TRASH_TTL_DAYS) 경과 격리분을 영구 소거한다. 방치 시
    # transcripts.db(부서당 최대 324MB)가 무한 누적되는데 resource_gate는 디스크 크기를 측정하지 않아
    # 신호가 없다 — 이 sweep가 유일한 회수 경로. 소유·주기는 CSO_DIRECTIVE 참조. --dry면 판정만.
    nt=0
    if [ -d "$TRASH_ROOT" ]; then
      ttl="${CYS_TRASH_TTL_DAYS:-14}"
      while IFS= read -r _td; do
        [ -n "$_td" ] || continue
        if [ "$dry" = 1 ]; then echo "[cys-dept] reap(dry): TRASH-EXPIRE $_td (>${ttl}d)"
        else rm -rf "$_td" && nt=$((nt+1)) && echo "[cys-dept] reap: TRASH-EXPIRE $_td (>${ttl}d)"; fi
      done < <(find "$TRASH_ROOT" -mindepth 1 -maxdepth 1 -type d -mtime +"$ttl" 2>/dev/null)
    fi
    echo "[cys-dept] reap 완료(dry=$dry): DEAD=$nd IDLE=$ni SKIP=$ns TRASH-EXPIRE=$nt. 부서 수=$(reg_count)"
    ;;
  promote-ceo)
    # 오너 지명 경로(2026-07-14): 오너/CSO가 기본 데몬 master를 CEO로 직접 지명 — 호출 자체가 동의.
    n=$(reg_count)
    [ "$n" -ge 1 ] || { echo "[cys-dept] 부서 0개 — CEO는 최소 1개 마스터(부서) 존재 후 단계다(승격 안 함)"; exit 4; }
    ceo_promote consented
    # ★진짜 승격 검증(2026-07-15 적대검증 D-2): consented(오너 지명)든 자동 승격이든 boot-marker
    # PENDING 게이트(부트 미완)는 못 뚫어 ceo_promote가 미승격인데 return 0 할 수 있다. GUI가 그 exit 0을
    # "✅ 승격 완료"로 오보하지 않게, 실제 승격 여부(md==CEO 템플릿 또는 .pre-ceo 백업 존재)를 post-verify해
    # 미승격이면 exit 5로 truthful 실패를 반환한다(approve_ceo_promotion→Err→GUI 실패 표시).
    _md="$PACK_DEFAULT/directives/MASTER_DIRECTIVE.md"; _ceo="$PACK_DEFAULT/directives/CEO_TEMPLATE.md"
    if cmp -s "$_md" "$_ceo" 2>/dev/null || [ -f "$_md.pre-ceo" ]; then
      :   # 승격 확정(directive=CEO 또는 백업 존재)
    else
      echo "[cys-dept] CEO 승격 미완(보류) — base master 미부트(.master-bootstrapped 부재) 또는 템플릿 상위집합 검사 실패(DCE-3 — 위 stderr 확인) 등. 원인 해소 후 재시도." >&2
      exit 5
    fi
    ;;
  promote-if-pending)
    # BOOTSTRAP_HARDENING WP-2: 부트 게이트로 보류된 승격의 해소 경로.
    # 조건 = PENDING 존재 + .master-bootstrapped 존재 + 부서≥1. 미충족=no-op(exit 0·멱등).
    # --request-only(부트 ⑦ 전용·비대기): 알림 재발행만 — 실제 승격은 하지 않는다
    #   (부트와 자동 승격의 분리 — 설계 v1.1 결함⑤). 대기형: ceo_promote(자동 승격, 제품 기본 정책) 경유.
    _pend_ok=0
    [ -f "$CEO_PENDING" ] && [ -f "$BOOT_MARKER" ] && [ "$(reg_count)" -ge 1 ] && _pend_ok=1
    if [ "${2:-}" = "--request-only" ]; then
      if [ "$_pend_ok" -eq 1 ]; then
        # ★A11 dedupe: 미해결 동종(pending·제목 'CEO 승격 대기')이 이미 있으면 push 생략(로그 1줄) —
        #   부트 ⑦가 세션마다 재발행해 feed가 동종 pending으로 적체되는 폭주 봉합. 출력 계약=
        #   `id\t[status]\tkind\ttitle\tdecision=x`(javis_cycle_verifier.parse_feed_list 실측 형식 —
        #   제목=4번째 탭 필드). 조회 실패(데몬 미기동 등)=fail-open(현행대로 재발행).
        if env -u CYS_SOCKET "$CYS" feed list --status pending 2>/dev/null \
             | awk -F'\t' '$4=="CEO 승격 대기"{found=1} END{exit !found}'; then
          echo "[cys-dept] CEO 승격 대기 알림 이미 pending — 재발행 생략(A11 dedupe)"
        else
          env -u CYS_SOCKET "$CYS" feed push --title "CEO 승격 대기" \
            --body "부트 완료 — 부서가 존재하여 CEO 승격이 대기 중입니다. 명령 팔레트의 'CEO 승격 진행' 또는 다음 부서 이벤트에서 자동 승격됩니다(제품 기본 정책)." >/dev/null 2>&1 || true
          echo "[cys-dept] CEO 승격 대기 알림 발행(request-only)"
        fi
      else
        echo "[cys-dept] promote-if-pending(request-only): 조건 미충족 — no-op (pending=$([ -f "$CEO_PENDING" ] && echo y || echo n) 마커=$([ -f "$BOOT_MARKER" ] && echo y || echo n) 부서=$(reg_count))"
      fi
      exit 0
    fi
    if [ "$_pend_ok" -eq 1 ]; then
      ceo_promote   # 자동 승격(제품 기본 정책) 경유 — 성공 시 PENDING 해소는 ceo_promote 내부
    else
      echo "[cys-dept] promote-if-pending: 조건 미충족 — no-op"
    fi
    ;;
  list)
    # stdout=등재명만(소비자 계약 불변) · 유령 소켓 디렉터리 고지는 stderr 로만(A2).
    _dl_names="$(reg_names)"
    if [ -n "$_dl_names" ]; then printf '%s\n' "$_dl_names"; fi
    dept_warn_unregistered_socks "$_dl_names"
    ;;
  sock)
    name="${2:-}"
    # ★D3(i): sock은 read-only(방송 fan-out 루프 `sock "$d"` 호출부)라 기존 등재의 레거시 비정형명
    #   (개명 전 이행기 — preflight WARN 소관)을 깨지 않도록 전체 화이트리스트는 강제하지 않는다.
    #   다만 '-' 선두(name 위치 '-' 전면 거부 규칙 — `sock --help`가 'cys-dept---help' 경로를 오출력)·
    #   빈 이름은 exit 2.
    case "$name" in
      ""|-*)
        echo "[cys-dept] sock: 부적격 이름('$name') — 빈 이름·'-' 선두 불가" >&2
        echo "usage: cys-dept sock <name>" >&2
        exit 2 ;;
    esac
    dept_sock "$name"
    ;;
  *)
    name="$cmd"; shift; [ "${1:-}" = "--" ] && shift
    [ "$#" -ge 1 ] || { echo "usage: cys-dept <name> -- <cmd>" >&2; exit 2; }
    # ★D3(i) passthrough(정리 동사형 규칙): 등재 또는 디스크 실존(state dir/pack dir) 이름은 비정형이라도
    #   허용 — 기존 부서 컨텍스트 실행·잔재 정리를 불차단. 비실존+비정형=exit 2(verb 오타가 passthrough로
    #   흡수돼 하류 cys autostart가 무등재 유령 데몬·state dir을 만드는 사고 절반 봉합). 비실존·정형=
    #   허용하되 CYS_NO_AUTOSTART=1 동반 export(★G0 D10 확정) — 죽은 소켓에서 cysd 부활 차단.
    if ! { reg_names | grep -Fxq -- "$name"; } \
       && [ ! -e "$(dept_state "$name")" ] && [ ! -e "$(dept_pack "$name")" ]; then
      validate_dept_name "$name" "<name> -- <cmd>" "비실존 부서 — verb 오타 의심. 신규 생성은 launch/create, 목록은 list."
      export CYS_NO_AUTOSTART=1
    fi
    export CYS_SOCKET="$(dept_sock "$name")" CYS_PACK_DIR="$(dept_pack "$name")"
    # ★G3 축1: 부서 컨텍스트 실행에 계정 dir 동반 주입(유도 3순위 resolve_lane_acctdir 재사용) —
    # 부서 스코프 config 시드 표적은 ${CYS_ACCOUNT_DIR}(실소비 SOT · 폴백 dir 없음)이라, 이 주입이
    # 없으면 컨텍스트 CLI(init-pack 등)의 훅 시드가 생략(loud WARN)으로 접힌다. 유도 실패 = 계정격리
    # 미사용 부서 → 무주입(기존 거동 · 회귀 0).
    _ctx_acct="$(resolve_lane_acctdir "$name" "$(dept_pack "$name")" | tail -1)"
    [ -n "$_ctx_acct" ] && export CYS_ACCOUNT_DIR="$_ctx_acct" || true   # set -e 안전(무주입=정상)
    exec "$@"
    ;;
esac
