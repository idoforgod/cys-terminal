<main id="main" tabindex="-1">

  <!-- DL-HERO (S0-pre) — 박사님 3호: 자비스(cys) 다운로드 밴드. SOT=_round/dlhero/DLHERO_DESIGN_SPEC.md §2(구조)+DLHERO_COPY.md §1(확정 카피·denylist 13어 0건). 충돌 해소: 헤드라인=h2(h1 불변)·도구 밴드 레지스터=슬로건B focal 공존·텍스트 전용=LCP 재실측 계약. 3링크=정적 가시(no-JS)·JS=감지 강조 전용+★윈도우 한정 파일 전환(크롬=exe·엣지/IE=zip — 오너 직접명령 2026-07-11로 '라우팅 금지' 예외 스코프 한정 해제·자동다운로드는 여전히 금지)·CSP 무변(외부 fetch 0). 링크=자체 호스팅 /downloads/(맥 DMG=Apple 공증본 — GitHub 자산은 무공증이라 오너 지시로 자체 호스팅 전환 2026-07-11). 릴리스 범프=RELEASE_BUMP_CHECK.md(4곳+S 슬롯 버전 동시 갱신+zip). -->
  <section class="dl-hero" id="download" aria-labelledby="dl-h">
    <div class="wrap dl-hero__grid">
      <div class="dl-hero__copy">
        <p class="kicker reveal in" lang="en">DOWNLOAD</p>
        <p class="dl-hero__claim reveal in">세계 최초의 AI 자비스 전용 터미널</p>
        <h2 id="dl-h" class="dl-hero__headline reveal in">AI 에이전트 팀을 지휘하는 터미널, 자비스(cys)</h2>
        <p class="dl-hero__sub reveal in">터미널 하나에서 AI 조직을 편성하고 운영합니다 — v{{cys:VER}} · macOS · Windows</p>
        <ul class="dl-hero__bullets reveal in">
          <li>master·CSO·워커·리뷰어를 역할별로 편성 — 역할 지침이 자동 주입되어 각 에이전트가 제 역할로 깨어납니다</li>
          <li>부서 단위 격리 데몬과 phoenix 자동복구 — 세션이 끊겨도 조직이 되살아납니다</li>
          <li>양방향 소켓 push로 에이전트가 먼저 보고하고, rate-limit은 자동 대기 후 이어서 재개합니다</li>
        </ul>
        <p class="dl-hero__winnote">참고 — 윈도우 설치파일: 크롬에서는 EXE를 바로 받고, 엣지·인터넷 익스플로러에서는 .exe 다운로드가 차단될 수 있어 ZIP을 받아 압축 해제 후 .exe를 실행합니다. .exe는 Authenticode 미서명(인증서 미보유)이라 실행 시 SmartScreen "알 수 없는 게시자" 경고가 뜰 수 있습니다("추가 정보 → 실행"으로 진행). 이는 알려진 상태이고 파일 무결성과는 무관합니다.</p>
      </div>
      <div class="dl-hero__actions reveal in" role="group" aria-label="다운로드">
      <a class="dl-btn" data-dl="mac-arm"
         href="/downloads/cys_{{cys:VER}}_aarch64.dmg">
        <span class="dl-btn__label">macOS <span class="dl-btn__arch" lang="en">Apple Silicon</span></span>
        <span class="dl-btn__meta" lang="en">cys_{{cys:VER}}_aarch64.dmg · {{cys:SIZE:_aarch64.dmg}}MB</span>
      </a>
      <a class="dl-btn" data-dl="mac-x64"
         href="/downloads/cys_{{cys:VER}}_x64.dmg">
        <span class="dl-btn__label">macOS <span class="dl-btn__arch" lang="en">Intel</span></span>
        <span class="dl-btn__meta" lang="en">cys_{{cys:VER}}_x64.dmg · {{cys:SIZE:_x64.dmg}}MB</span>
      </a>
      <a class="dl-btn" data-dl="win-x64"
         href="/downloads/cys_{{cys:VER}}_x64-setup.exe">
        <span class="dl-btn__label">Windows</span>
        <span class="dl-btn__meta" lang="en">cys_{{cys:VER}}_x64-setup.exe · {{cys:SIZE:_x64-setup.exe}}MB</span>
      </a>
      </div>
    </div>
  </section>
  <!-- DL-HERO 감지 JS(DESIGN_SPEC §3 사다리 + 오너 직접명령 2026-07-11): 강조 + ★윈도우 한정 파일 전환(크롬 등=exe·엣지/IE=zip — 엣지/IE의 exe 다운로드 차단 우회). 로컬 API만(외부 fetch 0=CSP 무변)·무JS=정적 exe 버튼+winnote zip 수동 링크 폴백·자동다운로드 여전히 금지·오탐 무해. -->
  <script>(function(){try{
    var uad=navigator.userAgentData;var pf=(uad&&uad.platform)||navigator.platform||'';
    function rec(k){var el=document.querySelector('.dl-btn[data-dl="'+k+'"]');if(el)el.classList.add('is-recommended');}
    var ua=navigator.userAgent||'';
    var isEdgeIE=/Edg\//.test(ua)||/Trident|MSIE/.test(ua)||!!(uad&&uad.brands&&uad.brands.some(function(b){return /Edge/i.test(b.brand);}));
    if(isEdgeIE){var w=document.querySelector('.dl-btn[data-dl="win-x64"]');if(w){
      w.setAttribute('href','/downloads/cys_{{cys:VER}}_x64-setup.zip');
      var m=w.querySelector('.dl-btn__meta');if(m)m.textContent='cys_{{cys:VER}}_x64-setup.zip · {{cys:SIZE:_x64-setup.zip}}MB';
    }}
    if(/^Win/i.test(pf)){rec('win-x64');}
    else if(/^Mac/i.test(pf)||/macOS/i.test(pf)){
      if(uad&&uad.getHighEntropyValues){uad.getHighEntropyValues(['architecture']).then(function(d){
        if(d.architecture==='arm')rec('mac-arm');else if(d.architecture==='x86')rec('mac-x64');
      }).catch(function(){});}
    }
  }catch(e){}})();</script>

  <!-- HERO (S0) — R1 강렬화: FUTURIST 표지(정적 LCP·webp preload 불변) + 라이브 above-fold 헤드라인 밴드(표지 상단).
       밴드=design .hero-band 계약(css/hero-band.noir.css 타이포·시안) + content 카피(슬로건B·환각0). ★h1=식별('최윤식…소장' SEO/a11y)·슬로건B=h2 시각 dominant.
       레이아웃(frontend): 밴드→표지 stacked·표지 ≤60vw fit(100svh내). 영문 'grows with you'·AX=표지 carry/Tier2 생략. CSS 비주얼=design·--dump-dom 1:1. ⑤ KT 진입=hero.noir. -->
  <section class="hero hero--cover" aria-labelledby="hero-h">
    <div class="wrap hero-stage">
      <div class="hero-band is-entering">
        <h1 id="hero-h" class="hero-band__name" data-i18n-html="hero-h1">최윤식 박사 · 미래학자<span class="sr-only"> · 아시아미래인재연구소 소장</span></h1>
        <h2 class="hero-band__title" data-i18n-html="hero-slogan">미래를 맞히지 않는다. 미래를 <em class="em">준비한다</em>.</h2>
        <!-- G7 이전(OB-544-01 구 태그라인 verbatim·ZWSP 포함 바이트 보존 — BLOCK_MAP 제안 목적지=히어로 · 박사님 사후 평가 대상(G7·CEO 집행지시 2026-07-07)) -->
        <p class="hero-band__tagline" lang="en">Entrepreneur, Writer and Speaker.​</p>
        <div class="hero-actions">
